#!/usr/bin/env bash
# Build helper for KSPKontroller.
#
#   ./ci build_sketch        Compile the Arduino sketch (arduino-cli)
#   ./ci build_sketch_debug  Compile the sketch with symbols and -Og into build/sketch-debug (for the SWD debugger)
#   ./ci build_KSPSerialIO   Compile the KSP plugin (dotnet / msbuild / xbuild), then KSPSerialIO.Hmi.dll (kRPC service
#                            for the Pi's VAB report; needs a KSP install with kRPC, skipped with a warning without one)
#   ./ci build_all           Plugin, sketch and Pi HMI (build_KSPSerialIO, build_sketch, build_hmi)
#   ./ci install             Copy the built plugin + config.xml into the local KSP (GameData/KSPSerialIO, and
#                            KSPSerialIO.Hmi.dll into GameData/KSPSerialIO/Plugins when built)
#   ./ci deploy              Build the plugin and install it into a local KSP (lists the installs it finds and asks which)
#   ./ci ksp_list            List the KSP installs found on this machine
#   ./ci disable_mod         Move the plugin out of GameData (to compare performance); enable_mod puts it back
#   ./ci save_log [LABEL]    Copy KSP.log and Player.log of the last run to build/perf/LABEL/ (KSP overwrites them)
#   ./ci deploy_all [PORT]   Build/deploy all three projects: plugin, Arduino and Pi HMI (including Pi tests)
#   ./ci docs                Generate the Doxygen documentation into build/docs
#   ./ci diagrams            Render the PlantUML diagrams in docs/diagrams to SVG (build/diagrams)
#   ./ci sphinx              Build the Sphinx site into build/sphinx (needs Python, Java; Doxygen optional)
#   ./ci upload_sketch [PORT] Upload the compiled sketch (build_sketch first); finds the board if PORT is missing
#   ./ci test_arduino [PORT] Compile, upload and test the board over serial (NO_UPLOAD=1 skips the upload)
#   ./ci verify [ARGS]       Run every consistency check (tools/verify.py): protocol, pins, versions, install, KSP.log, git;
#                            --board also tests the Arduino, --snapshot records the GameData mods, --log PATH analyses a saved log
#   ./ci build_hmi           Build the Raspberry Pi HMI (hmi-cpp/, C++, CMake) into build/hmi-cpp; on Windows natively
#                            with MSYS2 UCRT64 into build/hmi-cpp-win (WSL only when MSYS2 is missing)
#   ./ci hmi [ARGS]          Build it and run it on this PC, full screen on the secondary monitor (if any, else a
#                            window); targets the game on this PC; --demo: no KSP needed
#   ./ci test_hmi [--sim]    Build it and run its tests (ctest); --sim also runs it against ./ci sim --no-board (WSL/Linux)
#   ./ci test_hmi_container Run HMI tests and kspsim in Debian Bookworm, without the Pi (needs Docker)
#   ./ci hmi_desktop        Open both HMI and simulator windows in a browser desktop at localhost:6080
#   ./ci test_hmi_desktop   Exercise the real simulator GUI controls and their connection to the C++ HMI
#   ./ci deploy_hmi          Copy hmi-cpp/ to the Pi over SSH, build and test it there, install ksphmi.service, restart;
#                            then apply the kiosk boot (setup-kiosk.sh, asks for the sudo password) when it changed
#   ./ci hmi_logs [N]        Last N lines (default 60) of the HMI service log on the Pi
#                            (build_hmi_cpp and test_hmi_cpp are old names of build_hmi and test_hmi)
#   ./ci sim [ARGS]          Simulated KSP for tests without the game: drives the Arduino (KSPSerialIO protocol)
#                            and serves the Pi HMI (kRPC protocol); --no-board, --no-krpc, --headless, --port COMx
#   ./ci test_sim            Simulator tests, including the krpc client against the simulated kRPC server
#   ./ci clean               Remove build outputs
#   ./ci help
#
# Environment overrides:
#   FQBN    Arduino board          (default: arduino:renesas_uno:unor4wifi)
#   CONFIG  Plugin configuration   (default: Release)
#   KSPDIR  KSP install directory  (skips the question when several installs are found)
#   PLANTUML_JAR  Path to plantuml.jar (default: build/tools/plantuml.jar, downloaded if missing)
#   ARDUINO_PORT  Port for upload_sketch and test_arduino, same as passing PORT (optional)
#   SKETCH_BUILD  Build dir upload_sketch flashes (default: build/sketch; build/sketch-debug for the debug build)
#   NO_UPLOAD     Set to 1 to make test_arduino test the firmware already on the board
#   NO_TEST       Set to 1 to skip the board test at the end of deploy_all
#   RESET_CONFIG  Set to 1 to make install/deploy replace an existing config.xml (backup kept as .bak)
#   HMI_HOST      SSH destination of the Raspberry Pi (default: ksphmi, a Host entry in ~/.ssh/config)
#   HMI_KRPC_ADDRESS  kRPC server address the Pi uses (default: this PC's <hostname>.local when the Pi resolves it
#                     to this PC, else this PC's address as the Pi sees it)
#   NO_KIOSK      Set to 1 to make deploy_hmi only report an outdated kiosk boot instead of applying it

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD="$ROOT/build"
SKETCH="$ROOT/arduino-sketch/KSPIODemo9"
PLUGIN_SLN="$ROOT/KSPSerialIO/KSPSerialIO.sln"
PLUGIN_OUT="$ROOT/KSPSerialIO/KSPSerialIO/bin"
FQBN="${FQBN:-arduino:renesas_uno:unor4wifi}"
CONFIG="${CONFIG:-Release}"

REFASM_VERSION="1.0.3"
REFASM_DIR="$BUILD/refasm"
# KSPSerialIO.Hmi.dll (kRPC service KSPHMI): .NET 4.7.1 like KSP 1.12's Mono, because kRPC 0.7 is a .NET 4 assembly.
HMI_PLUGIN_PROJ="$ROOT/KSPSerialIO/KSPSerialIO.Hmi/KSPSerialIO.Hmi.csproj"
HMI_PLUGIN_OUT="$ROOT/KSPSerialIO/KSPSerialIO.Hmi/bin"
HMI_REFASM_DIR="$BUILD/refasm-net471"

log() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

is_windows() { case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) return 0 ;; *) return 1 ;; esac; }

# ---------------------------------------------------------------- arduino-cli

find_arduino_cli() {
  if command -v arduino-cli >/dev/null 2>&1; then
    command -v arduino-cli
    return
  fi

  local exe="$BUILD/tools/arduino-cli"
  is_windows && exe="$exe.exe"
  if [ ! -x "$exe" ]; then
    local url archive base="https://downloads.arduino.cc/arduino-cli/arduino-cli_latest"
    case "$(uname -s)/$(uname -m)" in
      MINGW*|MSYS*|CYGWIN*) url="${base}_Windows_64bit.zip" ;;
      Linux/x86_64)         url="${base}_Linux_64bit.tar.gz" ;;
      Linux/aarch64)        url="${base}_Linux_ARM64.tar.gz" ;;
      Darwin/arm64)         url="${base}_macOS_ARM64.tar.gz" ;;
      Darwin/x86_64)        url="${base}_macOS_64bit.tar.gz" ;;
      *) die "arduino-cli not found; install it from https://arduino.github.io/arduino-cli/" ;;
    esac
    log "arduino-cli not found, downloading to $BUILD/tools" >&2
    mkdir -p "$BUILD/tools"
    archive="$BUILD/tools/${url##*/}"
    curl -fsSL -o "$archive" "$url"
    case "$archive" in
      *.zip)    unzip -q -o "$archive" -d "$BUILD/tools" ;;
      *.tar.gz) tar -xzf "$archive" -C "$BUILD/tools" ;;
    esac
    rm -f "$archive"
  fi
  echo "$exe"
}

compile_sketch() {
  local cli="$1"
  shift
  local -a libraries=()
  if [ "${FQBN%:*}" = arduino:renesas_uno ]; then
    # Core 1.6.0 ships WDT with the old architecture name. Copy the installed
    # library into build/ and correct only metadata; never edit Arduino15.
    local properties platform source target
    properties="$("$cli" compile --show-properties=unexpanded --fqbn "$FQBN" "$SKETCH")"
    platform="$(printf '%s\n' "$properties" | sed -n 's/^runtime.platform.path=//p' | tr -d '\r')"
    [ -n "$platform" ] || die "Arduino platform path missing from build properties"
    if is_windows; then platform="$(cygpath -u "$platform")"; fi
    source="$platform/libraries/WDT"
    if tr -d '\r' < "$source/library.properties" | grep -qx 'architectures=renesas'; then
      target="$BUILD/wdt-compat/${platform##*/}/WDT"
      mkdir -p "$target"
      cp -R "$source/." "$target/"
      tr -d '\r' < "$source/library.properties" |
        sed 's/^architectures=renesas$/architectures=renesas,renesas_uno/' > "$target/library.properties"
      libraries=(--library "$target")
    fi
  fi
  # ${a[@]+...}: bash 3.2 (macOS /bin/bash) treats an empty array as unbound under set -u
  "$cli" compile --fqbn "$FQBN" ${libraries[@]+"${libraries[@]}"} "$@" "$SKETCH"
}

build_sketch() {
  local cli core
  cli="$(find_arduino_cli)"
  core="${FQBN%:*}"

  if ! "$cli" core list | awk 'NR>1 {print $1}' | grep -qx "$core"; then
    log "Installing Arduino core $core"
    "$cli" core update-index
    # --skip-post-install: avoids the interactive USB driver installer (not needed to compile)
    "$cli" core install --skip-post-install "$core"
  fi

  log "Compiling sketch for $FQBN"
  compile_sketch "$cli" --build-path "$BUILD/sketch"
}

# Debug build: same sketch, symbols and -Og, in its own build dir so build/sketch (what upload_sketch flashes)
# is untouched. Upload it with: SKETCH_BUILD=build/sketch-debug ./ci upload_sketch
build_sketch_debug() {
  local cli
  cli="$(find_arduino_cli)"
  log "Compiling sketch for $FQBN (debug, -Og) into $BUILD/sketch-debug"
  compile_sketch "$cli" --optimize-for-debug --build-path "$BUILD/sketch-debug"
}

# ------------------------------------------------------------------- plugin

# The plugin targets .NET Framework 3.5 (Unity/KSP). Modern SDKs ship no
# reference assemblies for it, so fetch them from NuGet when needed.
ensure_refassemblies() {
  local dir="$REFASM_DIR/build/.NETFramework/v3.5"
  if [ ! -f "$dir/mscorlib.dll" ]; then
    log "Downloading .NET 3.5 reference assemblies" >&2
    mkdir -p "$REFASM_DIR"
    curl -fsSL -o "$REFASM_DIR/ref.nupkg" \
      "https://www.nuget.org/api/v2/package/Microsoft.NETFramework.ReferenceAssemblies.net35/$REFASM_VERSION"
    unzip -q -o "$REFASM_DIR/ref.nupkg" -d "$REFASM_DIR"
    rm -f "$REFASM_DIR/ref.nupkg"
  fi
  if is_windows; then (cd "$dir" && pwd -W); else (cd "$dir" && pwd); fi
}

# Same contract as ensure_refassemblies, for the .NET 4.7.1 reference assemblies of KSPSerialIO.Hmi.
ensure_hmi_refassemblies() {
  local dir="$HMI_REFASM_DIR/build/.NETFramework/v4.7.1"
  if [ ! -f "$dir/mscorlib.dll" ]; then
    log "Downloading .NET 4.7.1 reference assemblies" >&2
    mkdir -p "$HMI_REFASM_DIR"
    curl -fsSL -o "$HMI_REFASM_DIR/ref.nupkg" \
      "https://www.nuget.org/api/v2/package/Microsoft.NETFramework.ReferenceAssemblies.net471/$REFASM_VERSION"
    unzip -q -o "$HMI_REFASM_DIR/ref.nupkg" -d "$HMI_REFASM_DIR"
    rm -f "$HMI_REFASM_DIR/ref.nupkg"
  fi
  if is_windows; then (cd "$dir" && pwd -W); else (cd "$dir" && pwd); fi
}

# KSPSerialIO.Hmi.dll compiles against the game's own assemblies (KSP_x64_Data/Managed) and GameData/kRPC/KRPC.Core.dll,
# read-only from the install find_kspdir picks. Without an install or kRPC it is skipped: KSPSerialIO.dll never needs it.
build_KSPSerialIO_Hmi() {
  local ksp refs
  if ! ksp="$(find_kspdir 2>/dev/null)"; then
    log "WARNING: no KSP install found (set KSPDIR): KSPSerialIO.Hmi.dll not built" >&2
    return 0
  fi
  if [ ! -f "$ksp/GameData/kRPC/KRPC.Core.dll" ]; then
    log "WARNING: $ksp has no GameData/kRPC/KRPC.Core.dll: KSPSerialIO.Hmi.dll not built (docs/hmi.rst, kRPC)" >&2
    return 0
  fi
  refs="$(ensure_hmi_refassemblies)"
  log "Building KSPSerialIO.Hmi ($CONFIG) against $ksp"
  if command -v msbuild >/dev/null 2>&1; then
    msbuild "$HMI_PLUGIN_PROJ" -p:Configuration="$CONFIG" -p:KSPDIR="$ksp" -p:FrameworkPathOverride="$refs" -v:minimal
  elif command -v xbuild >/dev/null 2>&1; then
    xbuild "$HMI_PLUGIN_PROJ" /p:Configuration="$CONFIG" /p:KSPDIR="$ksp" /p:FrameworkPathOverride="$refs"
  else
    dotnet build "$HMI_PLUGIN_PROJ" -c "$CONFIG" -v:minimal -nologo \
      -p:KSPDIR="$ksp" -p:FrameworkPathOverride="$refs" -nowarn:MSB3258
  fi
  log "Output: $HMI_PLUGIN_OUT/$CONFIG/KSPSerialIO.Hmi.dll"
}

build_KSPSerialIO() {
  if command -v msbuild >/dev/null 2>&1; then
    log "Building plugin with msbuild ($CONFIG)"
    msbuild "$PLUGIN_SLN" -p:Configuration="$CONFIG" -v:minimal
  elif command -v xbuild >/dev/null 2>&1; then
    log "Building plugin with xbuild ($CONFIG)"
    xbuild "$PLUGIN_SLN" /p:Configuration="$CONFIG"
  elif command -v dotnet >/dev/null 2>&1; then
    local refs
    refs="$(ensure_refassemblies)"
    log "Building plugin with dotnet ($CONFIG)"
    dotnet build "$PLUGIN_SLN" -c "$CONFIG" -v:minimal -nologo \
      -p:FrameworkPathOverride="$refs" -nowarn:MSB3258
  else
    die "no msbuild, xbuild or dotnet found"
  fi
  log "Output: $PLUGIN_OUT/$CONFIG/KSPSerialIO.dll"
  build_KSPSerialIO_Hmi
}

# A KSP install has a GameData folder next to the game executable
is_kspdir() {
  [ -d "$1/GameData" ] && { [ -f "$1/KSP_x64.exe" ] || [ -f "$1/KSP.x86_64" ] || [ -d "$1/KSP.app" ]; }
}

# Print every KSP install found, one per line as "<path><TAB><how it was found>", without duplicates.
# The install that was launched last comes first: Unity logs the game's Managed folder in Player.log
# as "Mono path[0] = '<install>/KSP_x64_Data/Managed'". Then Steam libraries and common GOG folders.
ksp_candidates() {
  local seen="|" log p key c steam lib root pf86
  pf86="$(printenv "ProgramFiles(x86)" 2>/dev/null || true)"
  add() {
    is_kspdir "$1" || return 0
    key="$(cd "$1" && pwd -P)"
    case "$seen" in *"|$key|"*) return 0 ;; esac
    seen="$seen$key|"
    printf '%s\t%s\n' "$(cd "$1" && { pwd -W 2>/dev/null || pwd -P; })" "$2"
  }

  for log in "${LOCALAPPDATA:-}/../LocalLow/Squad/Kerbal Space Program/Player.log" \
             "$HOME/.config/unity3d/Squad/Kerbal Space Program/Player.log" \
             "$HOME/Library/Logs/Squad/Kerbal Space Program/Player.log"; do
    [ -f "$log" ] || continue
    c="$(sed -n "s#^Mono path\[0\] = '\(.*\)/KSP[^/]*_Data/Managed'.*#\1#p" "$log" | head -1 | tr -d '\r')"
    [ -n "$c" ] && add "$c" "last launched"
  done

  for steam in "${ProgramFiles:-}/Steam" "$pf86/Steam" "$HOME/.steam/steam" \
               "$HOME/Library/Application Support/Steam"; do
    [ -f "$steam/steamapps/libraryfolders.vdf" ] || continue
    while IFS= read -r lib; do
      add "$lib/steamapps/common/Kerbal Space Program" "Steam"
    done < <({ echo "$steam"; sed -n 's#.*"path"[[:space:]]*"\(.*\)".*#\1#p' "$steam/steamapps/libraryfolders.vdf" | sed 's#\\#/#g'; } | tr -d '\r')
  done

  # GOG and plain "Games" folders on any Windows drive
  for root in /c /d /e /f /g /h; do
    [ -d "$root" ] || continue
    for p in "$root"/GOG*/"Kerbal Space Program" "$root"/GOG*/*/"Kerbal Space Program" \
             "$root"/"Program Files"*/"GOG Galaxy"/Games/"Kerbal Space Program" \
             "$root"/Games/"Kerbal Space Program"; do
      add "$p" "GOG / other"
    done
  done
}

# Print the KSP install to use: $KSPDIR if set, else the only one found, else ask which one
find_kspdir() {
  if [ -n "${KSPDIR:-}" ]; then
    is_kspdir "$KSPDIR" || die "KSPDIR=$KSPDIR is not a KSP install (no GameData folder and game executable)"
    echo "$KSPDIR"
    return
  fi

  local paths=() labels=() path label i choice
  while IFS=$'\t' read -r path label; do
    paths+=("$path"); labels+=("$label")
  done < <(ksp_candidates)

  [ "${#paths[@]}" -gt 0 ] || die "no KSP install found; set KSPDIR to the folder that contains GameData"
  if [ "${#paths[@]}" -eq 1 ]; then
    echo "${paths[0]}"
    return
  fi

  # More than one: list them (stderr, because stdout is captured) and let the user pick
  {
    echo "KSP installs found:"
    for i in "${!paths[@]}"; do
      printf '  %d) %s  [%s]\n' "$((i + 1))" "${paths[$i]}" "${labels[$i]}"
    done
  } >&2
  if [ ! -t 0 ]; then
    die "several KSP installs found and there is no terminal to ask; set KSPDIR to one of them"
  fi
  while true; do
    read -r -p "Install into which one? [1-${#paths[@]}, Enter = 1]: " choice < /dev/tty >&2
    choice="${choice:-1}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#paths[@]}" ]; then
      echo "${paths[$((choice - 1))]}"
      return
    fi
    echo "Enter a number between 1 and ${#paths[@]}" >&2
  done
}

# Show the KSP installs that deploy/install can target
ksp_list() {
  local path label
  while IFS=$'\t' read -r path label; do
    printf '%s  [%s]\n' "$path" "$label"
  done < <(ksp_candidates)
}

ksp_running() {
  if command -v tasklist >/dev/null 2>&1; then tasklist 2>/dev/null | grep -qi "KSP_x64.exe"
  else pgrep -f "KSP.x86_64|KSP.app" >/dev/null 2>&1; fi
}

# Copy the built plugin into a KSP install (the one from find_kspdir)
install_plugin() {
  local dll="$PLUGIN_OUT/$CONFIG/KSPSerialIO.dll"
  [ -f "$dll" ] || die "plugin not built; run ./ci build_KSPSerialIO first (or use ./ci deploy)"

  local ksp dest
  ksp="$(find_kspdir)"
  ! ksp_running || die "KSP is running and keeps the plugin DLL locked; close it and try again"

  dest="$ksp/GameData/KSPSerialIO"
  log "Installing into $ksp"
  mkdir -p "$dest/PluginData/KSPSerialIO"
  cp "$dll" "$dest/"
  cp "$ROOT/KSPSerialIO/Includes/PsimaxSerial.dll" "$dest/"
  # The Pi's VAB ship report (kRPC service KSPHMI); without kRPC in the game only this DLL fails to load.
  local hmi_dll="$HMI_PLUGIN_OUT/$CONFIG/KSPSerialIO.Hmi.dll"
  if [ -f "$hmi_dll" ]; then
    mkdir -p "$dest/Plugins"
    cp "$hmi_dll" "$dest/Plugins/"
    # kRPC reads the service documentation from the XML next to the DLL (it warns at every launch without it)
    if [ -f "${hmi_dll%.dll}.xml" ]; then cp "${hmi_dll%.dll}.xml" "$dest/Plugins/"; fi
  else
    log "KSPSerialIO.Hmi.dll not built: the Pi keeps its static VAB cards (./ci build_KSPSerialIO with kRPC installed)"
  fi
  # Never overwrite a config the user has already edited, unless RESET_CONFIG=1 (the old one is kept as .bak)
  local cfg="$dest/PluginData/KSPSerialIO/config.xml"
  if [ ! -f "$cfg" ]; then
    cp "$ROOT/KSPSerialIO/config.xml" "$cfg"
    log "Copied the default config.xml (edit DefaultPort for your system)"
  elif [ "${RESET_CONFIG:-0}" = "1" ]; then
    cp "$cfg" "$cfg.bak"
    cp "$ROOT/KSPSerialIO/config.xml" "$cfg"
    log "Replaced config.xml with the default (the previous one is config.xml.bak)"
  elif ! cmp -s "$cfg" "$ROOT/KSPSerialIO/config.xml"; then
    log "Kept the existing config.xml, which differs from the default (RESET_CONFIG=1 replaces it)"
  else
    log "config.xml is up to date"
  fi
  log "Installed: $dest"
}

# Copy KSP.log (and Player.log) of the last run to build/perf/LABEL/. KSP overwrites its log on every launch,
# so do this after each measured run, before starting the game again. Works with KSP open or closed.
save_log() {
  local label="${1:-run}" ksp dest playerlog
  label="${label//[^A-Za-z0-9._-]/_}"
  ksp="$(find_kspdir)"
  [ -f "$ksp/KSP.log" ] || die "no KSP.log in $ksp"
  dest="$BUILD/perf/$label"
  mkdir -p "$dest"
  cp "$ksp/KSP.log" "$dest/KSP.log"
  for playerlog in "${LOCALAPPDATA:-}/../LocalLow/Squad/Kerbal Space Program/Player.log" \
                   "$HOME/.config/unity3d/Squad/Kerbal Space Program/Player.log" \
                   "$HOME/Library/Logs/Squad/Kerbal Space Program/Player.log"; do
    [ -f "$playerlog" ] && cp "$playerlog" "$dest/Player.log" && break
  done
  log "Saved $dest ($(grep -c 'KSPSerialIO: perf' "$dest/KSP.log") plugin perf lines, $(grep -c '\[KSPPerf\]' "$dest/KSP.log") KSPPerf lines)"
  echo "$dest/KSP.log"
}

# Take the plugin out of GameData without deleting it (KSP must be closed), to compare the game with and without it
disable_mod() {
  local ksp
  ksp="$(find_kspdir)"
  ! ksp_running || die "KSP is running; close it first"
  [ -d "$ksp/GameData/KSPSerialIO" ] || die "the plugin is not installed in $ksp"
  rm -rf "$ksp/KSPSerialIO.disabled"
  mv "$ksp/GameData/KSPSerialIO" "$ksp/KSPSerialIO.disabled"
  log "Plugin disabled (moved to $ksp/KSPSerialIO.disabled). Re-enable it with ./ci enable_mod"
}

# Put the plugin back into GameData after disable_mod
enable_mod() {
  local ksp
  ksp="$(find_kspdir)"
  ! ksp_running || die "KSP is running; close it first"
  [ -d "$ksp/KSPSerialIO.disabled" ] || die "no disabled plugin found in $ksp"
  [ ! -d "$ksp/GameData/KSPSerialIO" ] || die "$ksp/GameData/KSPSerialIO already exists"
  mv "$ksp/KSPSerialIO.disabled" "$ksp/GameData/KSPSerialIO"
  log "Plugin enabled again in $ksp/GameData/KSPSerialIO"
}

# Build the plugin and install it into the local KSP
deploy() {
  build_KSPSerialIO
  install_plugin
  log "Start KSP and look for 'KSPSerialIO:' lines in KSP.log / Player.log"
}

docs() {
  command -v doxygen >/dev/null 2>&1 || die "doxygen not found; install it from https://www.doxygen.nl/"
  log "Generating documentation"
  (cd "$ROOT" && doxygen Doxyfile)
  log "Output: $BUILD/docs/html/index.html"
}

PLANTUML_JAR="${PLANTUML_JAR:-$BUILD/tools/plantuml.jar}"
PLANTUML_URL="https://github.com/plantuml/plantuml/releases/latest/download/plantuml.jar"

ensure_plantuml() {
  # On macOS /usr/bin/java may be a stub, while Homebrew's JDK is installed but keg-only.
  if ! java -version >/dev/null 2>&1 && command -v brew >/dev/null 2>&1; then
    local jdk
    jdk="$(brew --prefix openjdk 2>/dev/null || true)"
    [ ! -x "$jdk/bin/java" ] || export PATH="$jdk/bin:$PATH"
  fi
  java -version >/dev/null 2>&1 || die "working Java runtime missing; PlantUML needs Java"
  if [ ! -f "$PLANTUML_JAR" ]; then
    log "Downloading plantuml.jar"
    mkdir -p "$(dirname "$PLANTUML_JAR")"
    curl -fsSL -o "$PLANTUML_JAR" "$PLANTUML_URL"
  fi
  export PLANTUML_JAR
}

# Render every docs/diagrams/*.puml to SVG (also a quick way to validate diagram syntax)
diagrams() {
  ensure_plantuml
  log "Rendering diagrams"
  mkdir -p "$BUILD/diagrams"
  java -jar "$PLANTUML_JAR" -tsvg -o "$BUILD/diagrams" "$ROOT"/docs/diagrams/*.puml
  log "Output: $BUILD/diagrams"
}

# Skips the Windows Store "python" stub, which exists on PATH but is not a real interpreter
find_python() {
  local c
  # PATH first, then the default per-user and system install locations on Windows (a terminal
  # opened before Python was installed does not have the new PATH entry)
  for c in python3 python py \
      "${LOCALAPPDATA:-}"/Programs/Python/Python3*/python.exe \
      "${ProgramFiles:-}"/Python3*/python.exe; do
    if { command -v "$c" >/dev/null 2>&1 || [ -x "$c" ]; } && "$c" -c 'import sys; sys.exit(0)' >/dev/null 2>&1; then
      echo "$c"
      return
    fi
  done
  die "no working Python 3 found; install it from https://www.python.org/"
}

# Create build/venv on first use, install the given requirements file, print the venv bin directory
ensure_venv() {
  local py
  py="$(find_python)"
  if [ ! -d "$BUILD/venv" ]; then
    log "Creating virtual environment" >&2
    "$py" -m venv "$BUILD/venv" >&2
  fi
  local bin="$BUILD/venv/bin"
  [ -d "$BUILD/venv/Scripts" ] && bin="$BUILD/venv/Scripts"
  "$bin/python" -m pip install --quiet -r "$1" >&2
  echo "$bin"
}

sphinx() {
  ensure_plantuml
  local venv_bin
  venv_bin="$(ensure_venv "$ROOT/docs/requirements.txt")"

  log "Building Sphinx site"
  "$venv_bin/python" -m sphinx -n -W --keep-going -b html "$ROOT/docs" "$BUILD/sphinx"

  # Embed the Doxygen API reference next to the Sphinx pages when Doxygen is available
  if command -v doxygen >/dev/null 2>&1; then
    docs
    rm -rf "$BUILD/sphinx/api"
    cp -r "$BUILD/docs/html" "$BUILD/sphinx/api"
  else
    log "doxygen not found: the API reference link will be missing"
  fi
  log "Output: $BUILD/sphinx/index.html"
}

# Print the port of the first connected board that matches FQBN (empty when there is none)
find_board_port() {
  local cli
  cli="$(find_arduino_cli)"
  "$cli" board list | awk -v fqbn="$FQBN" 'index($0, fqbn) { print $1; exit }'
}

# Upload the compiled sketch (build/sketch) to the board on PORT, or on the first board that matches FQBN
upload_sketch() {
  local cli port="${1:-${ARDUINO_PORT:-}}"
  cli="$(find_arduino_cli)"
  [ -n "$port" ] || port="$(find_board_port)"
  [ -n "$port" ] || die "no $FQBN board found; plug it in or pass the port (./ci upload_sketch COM5)"
  log "Uploading to $port"
  "$cli" upload -p "$port" --fqbn "$FQBN" --input-dir "${SKETCH_BUILD:-$BUILD/sketch}"
  echo "$port" > "$BUILD/last_upload_port"
}

# Run the protocol tests against the board. With no PORT, or if the board does not answer there,
# every USB COM port is tried.
run_board_test() {
  local venv_bin
  venv_bin="$(ensure_venv "$ROOT/tools/requirements.txt")"
  log "Testing the Arduino controller"
  "$venv_bin/python" "$ROOT/tools/test_arduino.py" $1
}

# Compile and upload the firmware (unless NO_UPLOAD=1), then test the board with the real protocol
test_arduino() {
  local port="${1:-${ARDUINO_PORT:-}}"
  if [ "${NO_UPLOAD:-0}" != "1" ]; then
    build_sketch
    upload_sketch "$port"
    port="$(cat "$BUILD/last_upload_port")"
    # The board reboots into the new sketch and may re-enumerate under another COM number
    log "Waiting for the board to restart"
    sleep 4
  fi
  run_board_test "$port"
}

# Check prerequisites first. Build the plugin/sketch and build, test and deploy the Pi HMI
# before installing the plugin or flashing the board; a Pi failure must not flash the Arduino.
deploy_all() {
  local port="${1:-${ARDUINO_PORT:-}}"

  KSPDIR="$(find_kspdir)"
  export KSPDIR
  ! ksp_running || die "KSP is running and keeps the plugin DLL locked; close it and try again"
  [ -n "$port" ] || port="$(find_board_port)"
  [ -n "$port" ] || die "no $FQBN board found; plug it in or pass the port (./ci deploy_all COM5)"
  log "KSP: $KSPDIR"
  log "Board: $port ($FQBN)"
  hmi_preflight

  build_KSPSerialIO
  build_sketch
  deploy_hmi
  install_plugin
  upload_sketch "$port"

  if [ "${NO_TEST:-0}" != "1" ]; then
    port="$(cat "$BUILD/last_upload_port")"
    log "Waiting for the board to restart"
    sleep 4
    run_board_test "$port"
  fi
  log "Done: plugin installed in $KSPDIR, board flashed, Pi HMI built/tested and deployed to $HMI_HOST"
}

sim() {
  local bin
  bin="$(ensure_venv "$ROOT/tools/requirements.txt")"
  cd "$ROOT/tools"
  "$bin/python" -m kspsim "$@"
}

test_sim() {
  log "Simulator tests"
  (cd "$ROOT" && PYTHONDONTWRITEBYTECODE=1 "$(ensure_venv "$ROOT/tools/requirements.txt")/python" -m unittest tools/kspsim/test_kspsim.py)
}

# ------------------------------------------------------------------ Raspberry Pi HMI (hmi-cpp/, C++)
# Built with CMake: on the Pi by ./ci deploy_hmi; on Windows natively with MSYS2 UCRT64 (gcc, Ninja, SDL2 from
# pacman) into build/hmi-cpp-win, or inside WSL into build/hmi-cpp when MSYS2 is not installed.
HMI_DIR="$ROOT/hmi-cpp"
MSYS2_UCRT64="${MSYS2_UCRT64:-/c/msys64/ucrt64}"
HMI_MSYS2_INSTALL="winget install MSYS2.MSYS2, then in the MSYS2 UCRT64 shell: pacman -S --needed mingw-w64-ucrt-x86_64-{gcc,cmake,ninja,pkgconf,SDL2,SDL2_ttf}"
HMI_TITLE_BAR="${HMI_TITLE_BAR:-32}"  # WSLg window title bar height, Windows logical pixels
HMI_HOST="${HMI_HOST:-ksphmi}"
HMI_APT_PACKAGES="build-essential cmake pkg-config libsdl2-dev libsdl2-ttf-dev fonts-freefont-ttf"
HMI_BREW_PACKAGES="cmake pkg-config sdl2 sdl2_ttf"
# Fallback for a Linux box without root (this PC's WSL): the same libraries unpacked into build/hmi-cpp-deps.
# Names are Ubuntu 24.04's (t64); SDL2's runtime needs the audio/X11 libraries even if it never opens them.
HMI_LOCAL_DEBS="libsdl2-dev libsdl2-2.0-0 libsdl2-ttf-dev libsdl2-ttf-2.0-0 fonts-freefont-ttf libxss1
  libasound2t64 libdecor-0-0 libpulse0 libsamplerate0 libsndfile1 libasyncns0 libflac12t64 libvorbisenc2
  libvorbis0a libogg0 libopus0 libmpg123-0t64 libmp3lame0"

hmi_ssh_client() {
  local client=ssh
  # Git Bash's MSYS SSH can abort long builds with "poll: No error".
  # Prefer Windows OpenSSH when installed; preserve stdin for tar transfers.
  if is_windows; then
    local native
    native="$(cygpath -u "${SYSTEMROOT:-C:/Windows}")/System32/OpenSSH/ssh.exe"
    [ ! -x "$native" ] || client="$native"
  fi
  printf '%s\n' "$client"
}

hmi_ssh() {
  "$(hmi_ssh_client)" -o BatchMode=yes -o ConnectTimeout=5 "$HMI_HOST" "$@"
}

# With a terminal, for commands that prompt on the Pi (sudo's password).
hmi_ssh_tty() {
  "$(hmi_ssh_client)" -tt -o BatchMode=yes -o ConnectTimeout=5 "$HMI_HOST" "$@"
}

# Native Windows build: MSYS2's UCRT64 gcc, CMake, Ninja, pkgconf, SDL2 and SDL2_ttf.
hmi_native_windows() { is_windows && [ -x "$MSYS2_UCRT64/bin/g++.exe" ]; }

# Fallback without MSYS2: run the same ./ci target inside WSL when it is installed.
hmi_in_wsl() {
  local dir
  command -v wsl.exe >/dev/null ||
    die "no C++ toolchain on Windows and no WSL. Install MSYS2: $HMI_MSYS2_INSTALL"
  dir="$(cygpath -m "$ROOT")"
  dir="/mnt/$(printf '%s' "${dir:0:1}" | tr 'A-Z' 'a-z')${dir:2}"
  if hmi_native_windows; then
    log "Running ./ci $* in WSL (Linux only)"
  else
    log "No MSYS2 UCRT64 toolchain at $MSYS2_UCRT64: running ./ci $* in WSL"
    log "For the native Windows build: $HMI_MSYS2_INSTALL"
  fi
  MSYS_NO_PATHCONV=1 wsl.exe -- bash -lc "cd '$dir' && ./ci $*"
}

# MSYS2 first on PATH: its gcc, cmake, ninja, pkg-config and the DLLs ksphmi.exe and the tests load (SDL2.dll, ...).
hmi_win_env() {
  local free="$BUILD/hmi-cpp-deps/root/usr/share/fonts/truetype/freefont/FreeSansBold.ttf"
  export PATH="$MSYS2_UCRT64/bin:$PATH"
  # The Pi's font when an earlier WSL build unpacked it; otherwise ksphmi uses C:/Windows/Fonts/arialbd.ttf.
  if [ -z "${KSPHMI_FONT:-}" ] && [ -f "$free" ]; then export KSPHMI_FONT="$(cygpath -m "$free")"; fi
  unset KSPHMI_WSLG
}

build_hmi_windows() {
  hmi_win_env
  log "Building the HMI natively (MSYS2 UCRT64) into build/hmi-cpp-win"
  cmake -S "$(cygpath -m "$HMI_DIR")" -B "$(cygpath -m "$BUILD/hmi-cpp-win")" -G Ninja -DCMAKE_BUILD_TYPE=Release >/dev/null
  cmake --build "$(cygpath -m "$BUILD/hmi-cpp-win")"
}

hmi_env() {
  local deps="$BUILD/hmi-cpp-deps" lib arch dir
  if [ "$(uname -s)" = Darwin ]; then
    # macOS: Xcode's clang (g++), Homebrew's CMake/pkg-config/SDL2; the HMI finds Arial Bold by itself
    command -v cmake >/dev/null && command -v g++ >/dev/null && command -v pkg-config >/dev/null &&
      pkg-config --exists sdl2 SDL2_ttf 2>/dev/null ||
      die "C++ toolchain or SDL2 missing: xcode-select --install; brew install $HMI_BREW_PACKAGES"
    return 0
  fi
  command -v cmake >/dev/null && command -v g++ >/dev/null && command -v pkg-config >/dev/null ||
    die "C++ toolchain missing: sudo apt install $HMI_APT_PACKAGES"
  pkg-config --exists sdl2 SDL2_ttf 2>/dev/null && return 0
  command -v apt-get >/dev/null && command -v dpkg >/dev/null ||
    die "SDL2 development files missing: sudo apt install $HMI_APT_PACKAGES"
  if [ ! -f "$deps/.complete" ]; then
    log "SDL2 / SDL2_ttf not installed: unpacking the packages into $deps (no root needed)"
    rm -rf "$deps"; mkdir -p "$deps/debs"
    # shellcheck disable=SC2086
    (cd "$deps/debs" && apt-get download $HMI_LOCAL_DEBS) || die "apt-get download failed; or: sudo apt install $HMI_APT_PACKAGES"
    for f in "$deps"/debs/*.deb; do dpkg -x "$f" "$deps/root"; done
    touch "$deps/.complete"
  fi
  lib="$(ls -d "$deps"/root/usr/lib/*-linux-gnu | head -1)"
  arch="$(basename "$lib")"
  export PKG_CONFIG_PATH="$lib/pkgconfig" PKG_CONFIG_SYSROOT_DIR="$deps/root"
  # SDL2_ttf.pc names include dirs of -dev packages we do not need (harfbuzz, glib): CMake wants them to exist
  for dir in $(pkg-config --cflags-only-I sdl2 SDL2_ttf); do mkdir -p "${dir#-I}"; done
  export CXXFLAGS="${CXXFLAGS:-} -I$deps/root/usr/include/$arch"
  export LDFLAGS="${LDFLAGS:-} -Wl,-rpath-link,$lib:$lib/pulseaudio"
  export LD_LIBRARY_PATH="$lib:$lib/pulseaudio${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export KSPHMI_FONT="${KSPHMI_FONT:-$deps/root/usr/share/fonts/truetype/freefont/FreeSansBold.ttf}"
}

build_hmi() {
  if hmi_native_windows; then build_hmi_windows; return; fi
  if is_windows; then hmi_in_wsl build_hmi; return; fi
  hmi_env
  log "Building the HMI into build/hmi-cpp"
  cmake -S "$HMI_DIR" -B "$BUILD/hmi-cpp" -DCMAKE_BUILD_TYPE=Release >/dev/null
  cmake --build "$BUILD/hmi-cpp" -j"$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)"
}

# Build, then run it on this PC; ARGS as ksphmi --help, e.g. --demo. --desktop: the [display] monitor (auto: the
# last one). Natively on Windows (MSYS2) a secondary monitor is filled (full-screen desktop) and the game is
# 127.0.0.1. Under WSLg (fallback) full screen draws nothing: a plain window sized to the secondary monitor's
# work area (KSPHMI_WSLG=1), and since WSL's NAT makes 127.0.0.1 WSL itself, without --address/--demo it targets
# the Windows host, where KSP1's kRPC (0.0.0.0:50000/50001, UDP 50002) and the KSP2 Redux endpoint (UDP 50003) listen.
hmi() {
  if hmi_native_windows; then
    build_hmi_windows
    "$BUILD/hmi-cpp-win/ksphmi.exe" --desktop "$@"
    return
  fi
  if is_windows; then
    local fit=()
    # WSLg sizes windows in Windows logical units: fill the secondary monitor's work area minus the title bar.
    if ! printf '%s\n' "$@" | grep -qx -e --size -e --monitor; then
      local area
      area=$(powershell.exe -NoProfile -Command "Add-Type -AssemblyName System.Windows.Forms;
        \$s = [System.Windows.Forms.Screen]::AllScreens | Where-Object { -not \$_.Primary } | Select-Object -Last 1;
        if (\$s) { '{0}x{1}' -f \$s.WorkingArea.Width, (\$s.WorkingArea.Height - $HMI_TITLE_BAR) }" 2>/dev/null | tr -d '\r')
      [[ "$area" =~ ^[0-9]+x[0-9]+$ ]] && fit=(--size "$area") && log "secondary monitor work area: $area"
    fi
    hmi_in_wsl hmi "${fit[@]}" "$@"; return
  fi
  build_hmi
  local extra=() host
  if grep -qi microsoft /proc/version 2>/dev/null; then export KSPHMI_WSLG=1; fi
  if grep -qi microsoft /proc/version 2>/dev/null && ! printf '%s\n' "$@" | grep -qx -e --address -e --demo; then
    host=$(ip route show default 2>/dev/null | awk '{print $3; exit}')
    [ -n "$host" ] || die "no default route in WSL: pass --address HOST"
    log "WSL: the game's PC is the Windows host $host (kRPC and the Redux UDP endpoint)"
    extra=(--address "$host")
    export KSPHMI_REDUX_ADDRESS="${KSPHMI_REDUX_ADDRESS:-$host}"
  fi
  if [ "$(uname -s)" = Darwin ]; then
    "$BUILD/hmi-cpp/ksphmi" "$@"
  else
  "$BUILD/hmi-cpp/ksphmi" --desktop "${extra[@]}" "$@"
  fi
}

# End to end: tools/kspsim serves the real kRPC protocol; the HMI must follow its vessel and draw a frame.
hmi_sim() {
  local py out port=50300 sim_pid rc=0
  py="${KSPSIM_PYTHON:-$(ensure_venv "$ROOT/tools/requirements.txt")/python}"
  "$py" -c "import krpc, google.protobuf" 2>/dev/null ||
    die "tools/kspsim needs the krpc and protobuf Python packages (pip install -r tools/requirements.txt)"
  out="$BUILD/hmi-cpp-sim"; mkdir -p "$out"
  log "kspsim on 127.0.0.1:$port/$((port + 1)), HMI against it"
  (cd "$ROOT/tools" && exec "$py" -m kspsim --no-board --headless --seconds 40 --address 127.0.0.1 \
      --rpc-port "$port" --stream-port "$((port + 1))" --skin apollo) >"$out/kspsim.log" 2>&1 &
  sim_pid=$!
  sleep 3
  KSPHMI_LOCAL_CONFIG=/dev/null "$BUILD/hmi-cpp/ksphmi" --address 127.0.0.1 --size 2520x1680 --seconds 8 \
      --screenshot "$out/flight.png" --config <(printf '[krpc]\ndiscovery = false\nrpc_port = %d\nstream_port = %d\n' "$port" "$((port + 1))") \
      >"$out/hmi.log" 2>&1 || rc=$?
  kill "$sim_pid" 2>/dev/null || true
  wait "$sim_pid" 2>/dev/null || true
  cat "$out/hmi.log"
  [ "$rc" = 0 ] || die "HMI exited with $rc"
  grep -q "following .* around Kerbin" "$out/hmi.log" || die "the HMI never followed the simulated vessel"
  # kspsim asks for the apollo skin on the UDP 50002 context reply: the HMI must switch at runtime
  # Context may arrive before Display is created: it then logs the initial skin as '(config)'.
  grep -q "context skin: apollo" "$out/hmi.log" || die "the HMI never received the simulator's skin"
  grep -q "ksphmi.display: skin: apollo" "$out/hmi.log" || die "the HMI ignored the simulator's skin (context reply)"
  log "OK: followed the simulated vessel; frame saved to $out/flight.png"
  "$py" "$ROOT/tools/test_editor_hmi.py" "$BUILD/hmi-cpp/ksphmi"
}

test_hmi_container() {
  # Docker Desktop can install its CLI for this user without adding it to PATH.
  if ! command -v docker >/dev/null && [ -x "$HOME/.docker/bin/docker" ]; then
    export PATH="$HOME/.docker/bin:$PATH"
  fi
  command -v docker >/dev/null || die "Docker missing: install and start Docker, then retry ./ci test_hmi_container"
  local platform="${HMI_PLATFORM:-linux/arm64}" out tag mode="${1:-test}"
  case "$platform" in
    linux/arm64|linux/amd64|linux/arm/v7) ;;
    *) die "HMI_PLATFORM must be linux/arm64, linux/amd64 or linux/arm/v7" ;;
  esac
  out="$BUILD/hmi-container/${platform//\//-}"
  tag="ksphmi-test:${platform//\//-}"
  if [ "$mode" = desktop ]; then
    local state
    docker info >/dev/null 2>&1 || die "Docker engine unavailable: start Docker Desktop"
    state="$(docker inspect --format '{{.State.Status}}' ksphmi-desktop 2>/dev/null || true)"
    if [ "$state" = running ]; then
      log "HMI desktop already running: http://localhost:6080/vnc.html?autoconnect=true&resize=scale"
      log "To rebuild after source changes: docker stop ksphmi-desktop, then ./ci hmi_desktop"
      return
    fi
    [ -z "$state" ] || die "ksphmi-desktop exists (state: $state). Inspect it with docker logs ksphmi-desktop; remove it with docker rm ksphmi-desktop before retrying"
  fi
  mkdir -p "$out"
  docker build --platform "$platform" -t "$tag" -f "$ROOT/tools/hmi-container/Dockerfile" "$ROOT"
  if [ "$mode" = desktop ]; then
    MSYS_NO_PATHCONV=1 docker run --rm -d --init --name ksphmi-desktop --platform "$platform" \
      --user "$(id -u):$(id -g)" --shm-size=256m \
      -p 127.0.0.1:6080:6080 \
      --mount "type=bind,source=$ROOT,target=/src,readonly" \
      --mount "type=bind,source=$out,target=/out" "$tag" desktop
    log "Open http://localhost:6080/vnc.html?autoconnect=true&resize=scale (first build may take a minute)"
    log "Logs: docker logs -f ksphmi-desktop; stop: docker stop ksphmi-desktop"
    return
  fi
  MSYS_NO_PATHCONV=1 docker run --rm --platform "$platform" --network none \
    --user "$(id -u):$(id -g)" \
    --mount "type=bind,source=$ROOT,target=/src,readonly" \
    --mount "type=bind,source=$out,target=/out" "$tag" "$mode"
  log "HMI test artifacts: $out/hmi-cpp-sim (flight.png and logs)"
}

test_hmi() {
  if hmi_native_windows; then
    build_hmi_windows
    log "HMI tests (native Windows)"
    (cd "$BUILD/hmi-cpp-win" && ctest --output-on-failure)
    # hmi_sim runs kspsim with Linux's python3 and the Linux build: only inside WSL.
    if [ "${1:-}" = "--sim" ]; then hmi_in_wsl test_hmi --sim; fi
    return
  fi
  if is_windows; then hmi_in_wsl test_hmi "$@"; return; fi
  build_hmi
  log "HMI unit, layout and kiosk tests (ctest)"
  (cd "$BUILD/hmi-cpp" && ctest --output-on-failure)
  if [ "${1:-}" = "--sim" ]; then hmi_sim; fi
}

# Layout on the Pi: ~/ksphmi/cpp (hmi-cpp sources and config.toml, replaced on every deploy; its build/ directory is
# kept so CMake rebuilds incrementally), ~/ksphmi/env (kRPC address), ~/ksphmi/config.local.toml (yours, never touched).
hmi_preflight() {
  hmi_ssh true || die "cannot reach '$HMI_HOST' over SSH; add a 'Host ksphmi' entry to ~/.ssh/config or set HMI_HOST (docs/hmi.rst)"
  local missing
  missing="$(hmi_ssh "for p in $HMI_APT_PACKAGES; do dpkg -s \$p >/dev/null 2>&1 || echo \"  \$p not installed\"; done
    [ -e /var/lib/systemd/linger/\$USER ] || echo '  lingering off'")"
  [ -z "$missing" ] || die "the Pi needs its one-time setup:
$missing
run on the Pi: sudo apt install -y $HMI_APT_PACKAGES && sudo loginctl enable-linger \$USER"
}

# The kRPC endpoint the Pi keeps in ~/ksphmi/env: HMI_KRPC_ADDRESS if set; else this computer's mDNS name
# (<hostname>.local) when the Pi resolves it to the address this SSH session comes from, so DHCP changes need no
# redeploy (user, 2026-11-16); else that numeric address. The HMI resolves the name again at every reconnect.
hmi_pc_address() {
  if [ -n "${HMI_KRPC_ADDRESS:-}" ]; then echo "$HMI_KRPC_ADDRESS"; return; fi
  local ip name short
  # Over IPv4: with ksphmi reached by its .local name, ssh may prefer IPv6 link-local, which the HMI cannot use.
  ip="$("$(hmi_ssh_client)" -4 -o BatchMode=yes -o ConnectTimeout=5 "$HMI_HOST" 'echo "${SSH_CLIENT%% *}"' </dev/null)"
  ip="${ip%%\%*}"
  short="$(hostname 2>/dev/null || true)"
  short="${short%%.*}"
  if [ -n "$short" ]; then
    name="$short.local"
    # IPv4 and IPv6 answers: over a .local alias the SSH session itself may arrive on IPv6 link-local.
    if hmi_ssh "getent ahosts '$name' 2>/dev/null | cut -d' ' -f1 | sed 's/%.*//' | grep -qix '$ip'" </dev/null; then
      echo "$name"
      return
    fi
    echo "==> $HMI_HOST does not resolve $name to $ip" >&2
  fi
  # The HMI connects over IPv4 only: never hand it an IPv6 address.
  case "$ip" in
    *:*) die "cannot give the Pi this PC's IPv4 address (SSH came over IPv6 $ip): set HMI_KRPC_ADDRESS" ;;
  esac
  echo "$ip"
}

deploy_hmi() {
  hmi_preflight
  local pc_ip
  pc_ip="$(hmi_pc_address)"

  log "Copying hmi-cpp to $HMI_HOST:~/ksphmi/cpp (kRPC server: $pc_ip)"
  # cd + relative names: GNU tar reads a "C:/..." argument as a remote host
  (cd "$HMI_DIR" && tar -cf - CMakeLists.txt config.toml include src tests systemd assets) |
    hmi_ssh 'set -e; cd ~/ksphmi; rm -rf cpp.new; mkdir -p cpp.new cpp; tar -C cpp.new -xf -
      find cpp -mindepth 1 -maxdepth 1 ! -name build -exec rm -rf {} +
      mv cpp.new/* cpp/; rmdir cpp.new'

  # The running service keeps its binary until the restart below: a failed build or test leaves it untouched.
  log "Building on $HMI_HOST (CMake Release, -j4) and running the tests there"
  hmi_ssh 'set -e; cd ~/ksphmi/cpp
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release >/dev/null
    cmake --build build -j4
    cd build && ctest --output-on-failure' || die "build or tests failed on $HMI_HOST: the service was not restarted"

  log "Installing ksphmi.service and restarting it"
  hmi_ssh "set -e
    cd ~/ksphmi
    printf 'KSPHMI_KRPC_ADDRESS=%s\n' '$pc_ip' > env
    mkdir -p ~/.config/systemd/user
    # the C++ trial unit and the Python runtime (app/, venv/) are gone: ksphmi.service is the C++ HMI now
    if [ -f ~/.config/systemd/user/ksphmi-cpp.service ]; then
      systemctl --user disable --now ksphmi-cpp.service 2>/dev/null || true
      rm -f ~/.config/systemd/user/ksphmi-cpp.service
    fi
    rm -rf app venv
    cp cpp/systemd/ksphmi.service ~/.config/systemd/user/
    systemctl --user daemon-reload
    systemctl --user enable ksphmi.service 2>/dev/null
    systemctl --user restart ksphmi.service"
  # Restart=always hides a crash loop behind "active": wait past RestartSec and require zero restarts
  sleep 8
  local state
  state="$(hmi_ssh 'echo "$(systemctl --user is-active ksphmi.service)/$(systemctl --user show ksphmi.service -p NRestarts --value)"' || true)"
  hmi_logs 15
  [ "$state" = "active/0" ] || die "the HMI service is not running cleanly on $HMI_HOST (state/restarts: $state, log above)"
  hmi_kiosk
  log "Done: HMI running on $HMI_HOST"
}

# Kiosk boot (no console text, loading screen, cursor off, persistent journal): setup-kiosk.sh needs root, so it
# runs only when the deployed script differs from the one last applied (/etc/ksphmi-kiosk.applied holds its sha256).
# Without a terminal (or with NO_KIOSK=1) it only prints the command; it never reboots the Pi by itself.
hmi_kiosk() {
  local want have cmd='sudo sh ~/ksphmi/cpp/systemd/setup-kiosk.sh'
  want="$(hmi_ssh "sha256sum ~/ksphmi/cpp/systemd/setup-kiosk.sh | cut -d' ' -f1")"
  have="$(hmi_ssh 'cat /etc/ksphmi-kiosk.applied 2>/dev/null' || true)"
  if [ -n "$want" ] && [ "$want" = "$have" ]; then
    log "Kiosk boot up to date on $HMI_HOST"
    return
  fi
  if [ "${NO_KIOSK:-0}" = "1" ] || [ ! -t 0 ] || [ ! -t 1 ]; then
    log "WARNING: the kiosk boot on $HMI_HOST is not the deployed version. Run it (sudo password), then reboot:"
    log "  ssh -t $HMI_HOST '$cmd && sudo reboot'"
    return
  fi
  log "Applying the kiosk boot on $HMI_HOST: sudo asks for the Pi user's password"
  hmi_ssh_tty "$cmd" || die "setup-kiosk.sh failed on $HMI_HOST (the HMI itself is deployed and running)"
  log "Kiosk boot applied; it takes effect at the next reboot: ssh -t $HMI_HOST sudo reboot"
}

hmi_logs() {
  # Raspberry Pi OS keeps no per-user journal: read the unit's lines from the system journal (user is in adm)
  hmi_ssh "journalctl _SYSTEMD_USER_UNIT=ksphmi.service -n ${1:-60} --no-pager -o short"
}

clean() {
  log "Removing build outputs"
  rm -rf "$BUILD" "$PLUGIN_OUT" "$ROOT/KSPSerialIO/KSPSerialIO/obj"
}

usage() { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed -n 's/^# \{0,1\}//p'; }

case "${1:-help}" in
  build_sketch)      build_sketch ;;
  build_sketch_debug) build_sketch_debug ;;
  build_KSPSerialIO) build_KSPSerialIO ;;
  build_all)         build_KSPSerialIO; build_sketch; build_hmi ;;
  install)           install_plugin ;;
  deploy)            deploy ;;
  deploy_all)        shift; deploy_all "$@" ;;
  save_log)          shift; save_log "$@" ;;
  disable_mod)       disable_mod ;;
  enable_mod)        enable_mod ;;
  ksp_list)          ksp_list ;;
  docs)              docs ;;
  diagrams)          diagrams ;;
  sphinx)            sphinx ;;
  upload_sketch)     shift; upload_sketch "$@" ;;
  test_arduino)      shift; test_arduino "$@" ;;
  verify)            shift
                     # off Windows the default is the first install ./ci ksp_list finds (the last launched)
                     if [ -z "${KSPDIR:-}" ] && ! is_windows; then
                       KSPDIR="$(ksp_candidates | head -1 | cut -f1 || true)"; export KSPDIR
                     fi
                     "$(ensure_venv "$ROOT/tools/requirements.txt")/python" "$ROOT/tools/verify.py" "$@" ;;
  hmi)               shift; hmi "$@" ;;
  build_hmi|build_hmi_cpp) build_hmi ;;
  test_hmi|test_hmi_cpp)   shift; test_hmi "$@" ;;
  test_hmi_container) test_hmi_container ;;
  hmi_desktop) test_hmi_container desktop ;;
  test_hmi_desktop) test_hmi_container desktop-smoke ;;
  deploy_hmi)        deploy_hmi ;;
  hmi_logs)          shift; hmi_logs "$@" ;;
  sim)               shift; sim "$@" ;;
  test_sim)          test_sim ;;
  clean)             clean ;;
  help|-h|--help)    usage ;;
  *) usage >&2; exit 1 ;;
esac
