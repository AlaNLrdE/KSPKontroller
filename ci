#!/usr/bin/env bash
# Build helper for KSPKontroller.
#
#   ./ci build_sketch        Compile the Arduino sketch (arduino-cli)
#   ./ci build_sketch_debug  Compile the sketch with symbols and -Og into build/sketch-debug (for the SWD debugger)
#   ./ci build_KSPSerialIO   Compile the KSP plugin (dotnet / msbuild / xbuild)
#   ./ci build_all           Both of the above
#   ./ci install             Copy the built plugin + config.xml into the local KSP (GameData/KSPSerialIO)
#   ./ci deploy              Build the plugin and install it into a local KSP (lists the installs it finds and asks which)
#   ./ci ksp_list            List the KSP installs found on this machine
#   ./ci disable_mod         Move the plugin out of GameData (to compare performance); enable_mod puts it back
#   ./ci save_log [LABEL]    Copy KSP.log and Player.log of the last run to build/perf/LABEL/ (KSP overwrites them)
#   ./ci deploy_all [PORT]   Build everything, install the plugin into a local KSP and flash the board, then test it
#   ./ci docs                Generate the Doxygen documentation into build/docs
#   ./ci diagrams            Render the PlantUML diagrams in docs/diagrams to SVG (build/diagrams)
#   ./ci sphinx              Build the Sphinx site into build/sphinx (needs Python, Java; Doxygen optional)
#   ./ci upload_sketch [PORT] Upload the compiled sketch (build_sketch first); finds the board if PORT is missing
#   ./ci test_arduino [PORT] Compile, upload and test the board over serial (NO_UPLOAD=1 skips the upload)
#   ./ci verify [ARGS]       Run every consistency check (tools/verify.py): protocol, pins, versions, install, KSP.log, git;
#                            --board also tests the Arduino, --snapshot records the GameData mods, --log PATH analyses a saved log
#   ./ci hmi [ARGS]          Run the Raspberry Pi HMI on this PC in a window (--demo: simulated orbit, no KSP needed)
#   ./ci test_hmi            Unit tests of the HMI (no pygame, no kRPC needed)
#   ./ci deploy_hmi          Test, copy hmi-pi/ to the Pi over SSH, install its service and restart it
#   ./ci hmi_logs [N]        Last N lines (default 60) of the HMI service log on the Pi
#   ./ci build_hmi_cpp       Build the C++ HMI (hmi-cpp/, CMake) into build/hmi-cpp; on Windows inside WSL
#   ./ci test_hmi_cpp [--sim] Build and run its tests; --sim also runs it against ./ci sim --no-board --headless
#   ./ci sim [ARGS]          Simulated KSP for tests without the game: drives the Arduino (KSPSerialIO protocol)
#                            and serves the Pi HMI (kRPC protocol); --no-board, --no-krpc, --headless, --port COMx
#   ./ci test_sim            Simulator tests, including the HMI kRPC client against the simulated server
#   ./ci clean               Remove build outputs
#   ./ci help
#
# Environment overrides:
#   FQBN    Arduino board          (default: arduino:renesas_uno:unor4wifi)
#   CONFIG  Plugin configuration   (default: Release)
#   KSPDIR  KSP install directory  (skips the question when several installs are found)
#   PLANTUML_JAR  Path to plantuml.jar (default: build/tools/plantuml.jar, downloaded if missing)
#   ARDUINO_PORT  Port for upload_sketch and test_arduino, same as passing PORT (optional)
#   SKETCH_BUILD  Build dir upload_sketch flashes (default: build/sketch; build/sketch-debug for the debug build)
#   NO_UPLOAD     Set to 1 to make test_arduino test the firmware already on the board
#   NO_TEST       Set to 1 to skip the board test at the end of deploy_all
#   RESET_CONFIG  Set to 1 to make install/deploy replace an existing config.xml (backup kept as .bak)
#   HMI_HOST      SSH destination of the Raspberry Pi (default: ksphmi, a Host entry in ~/.ssh/config)
#   HMI_KRPC_ADDRESS  kRPC server address the Pi uses (default: this PC's address as the Pi sees it)

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD="$ROOT/build"
SKETCH="$ROOT/arduino-sketch/KSPIODemo9"
PLUGIN_SLN="$ROOT/KSPSerialIO/KSPSerialIO.sln"
PLUGIN_OUT="$ROOT/KSPSerialIO/KSPSerialIO/bin"
FQBN="${FQBN:-arduino:renesas_uno:unor4wifi}"
CONFIG="${CONFIG:-Release}"

REFASM_VERSION="1.0.3"
REFASM_DIR="$BUILD/refasm"

log() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

is_windows() { case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) return 0 ;; *) return 1 ;; esac; }

# ---------------------------------------------------------------- arduino-cli

find_arduino_cli() {
  if command -v arduino-cli >/dev/null 2>&1; then
    command -v arduino-cli
    return
  fi

  local exe="$BUILD/tools/arduino-cli"
  is_windows && exe="$exe.exe"
  if [ ! -x "$exe" ]; then
    local url archive
    case "$(uname -s)" in
      MINGW*|MSYS*|CYGWIN*) url="https://downloads.arduino.cc/arduino-cli/arduino-cli_latest_Windows_64bit.zip" ;;
      Linux)                url="https://downloads.arduino.cc/arduino-cli/arduino-cli_latest_Linux_64bit.tar.gz" ;;
      *) die "arduino-cli not found; install it from https://arduino.github.io/arduino-cli/" ;;
    esac
    log "arduino-cli not found, downloading to $BUILD/tools" >&2
    mkdir -p "$BUILD/tools"
    archive="$BUILD/tools/${url##*/}"
    curl -fsSL -o "$archive" "$url"
    case "$archive" in
      *.zip)    unzip -q -o "$archive" -d "$BUILD/tools" ;;
      *.tar.gz) tar -xzf "$archive" -C "$BUILD/tools" ;;
    esac
    rm -f "$archive"
  fi
  echo "$exe"
}

build_sketch() {
  local cli core
  cli="$(find_arduino_cli)"
  core="${FQBN%:*}"

  if ! "$cli" core list | awk 'NR>1 {print $1}' | grep -qx "$core"; then
    log "Installing Arduino core $core"
    "$cli" core update-index
    # --skip-post-install: avoids the interactive USB driver installer (not needed to compile)
    "$cli" core install --skip-post-install "$core"
  fi

  log "Compiling sketch for $FQBN"
  "$cli" compile --fqbn "$FQBN" --build-path "$BUILD/sketch" "$SKETCH"
}

# Debug build: same sketch, symbols and -Og, in its own build dir so build/sketch (what upload_sketch flashes)
# is untouched. Upload it with: SKETCH_BUILD=build/sketch-debug ./ci upload_sketch
build_sketch_debug() {
  local cli
  cli="$(find_arduino_cli)"
  log "Compiling sketch for $FQBN (debug, -Og) into $BUILD/sketch-debug"
  "$cli" compile --fqbn "$FQBN" --optimize-for-debug --build-path "$BUILD/sketch-debug" "$SKETCH"
}

# ------------------------------------------------------------------- plugin

# The plugin targets .NET Framework 3.5 (Unity/KSP). Modern SDKs ship no
# reference assemblies for it, so fetch them from NuGet when needed.
ensure_refassemblies() {
  local dir="$REFASM_DIR/build/.NETFramework/v3.5"
  if [ ! -f "$dir/mscorlib.dll" ]; then
    log "Downloading .NET 3.5 reference assemblies"
    mkdir -p "$REFASM_DIR"
    curl -fsSL -o "$REFASM_DIR/ref.nupkg" \
      "https://www.nuget.org/api/v2/package/Microsoft.NETFramework.ReferenceAssemblies.net35/$REFASM_VERSION"
    unzip -q -o "$REFASM_DIR/ref.nupkg" -d "$REFASM_DIR"
    rm -f "$REFASM_DIR/ref.nupkg"
  fi
  if is_windows; then (cd "$dir" && pwd -W); else (cd "$dir" && pwd); fi
}

build_KSPSerialIO() {
  if command -v msbuild >/dev/null 2>&1; then
    log "Building plugin with msbuild ($CONFIG)"
    msbuild "$PLUGIN_SLN" -p:Configuration="$CONFIG" -v:minimal
  elif command -v xbuild >/dev/null 2>&1; then
    log "Building plugin with xbuild ($CONFIG)"
    xbuild "$PLUGIN_SLN" /p:Configuration="$CONFIG"
  elif command -v dotnet >/dev/null 2>&1; then
    local refs
    refs="$(ensure_refassemblies)"
    log "Building plugin with dotnet ($CONFIG)"
    dotnet build "$PLUGIN_SLN" -c "$CONFIG" -v:minimal -nologo \
      -p:FrameworkPathOverride="$refs" -nowarn:MSB3258
  else
    die "no msbuild, xbuild or dotnet found"
  fi
  log "Output: $PLUGIN_OUT/$CONFIG/KSPSerialIO.dll"
}

# A KSP install has a GameData folder next to the game executable
is_kspdir() {
  [ -d "$1/GameData" ] && { [ -f "$1/KSP_x64.exe" ] || [ -f "$1/KSP.x86_64" ] || [ -d "$1/KSP.app" ]; }
}

# Print every KSP install found, one per line as "<path><TAB><how it was found>", without duplicates.
# The install that was launched last comes first: Unity logs the game's Managed folder in Player.log
# as "Mono path[0] = '<install>/KSP_x64_Data/Managed'". Then Steam libraries and common GOG folders.
ksp_candidates() {
  local seen="|" log p key c steam lib root pf86
  pf86="$(printenv "ProgramFiles(x86)" 2>/dev/null || true)"
  add() {
    is_kspdir "$1" || return 0
    key="$(cd "$1" && pwd -P)"
    case "$seen" in *"|$key|"*) return 0 ;; esac
    seen="$seen$key|"
    printf '%s\t%s\n' "$(cd "$1" && { pwd -W 2>/dev/null || pwd -P; })" "$2"
  }

  for log in "${LOCALAPPDATA:-}/../LocalLow/Squad/Kerbal Space Program/Player.log" \
             "$HOME/.config/unity3d/Squad/Kerbal Space Program/Player.log" \
             "$HOME/Library/Logs/Squad/Kerbal Space Program/Player.log"; do
    [ -f "$log" ] || continue
    c="$(sed -n "s#^Mono path\[0\] = '\(.*\)/KSP[^/]*_Data/Managed'.*#\1#p" "$log" | head -1 | tr -d '\r')"
    [ -n "$c" ] && add "$c" "last launched"
  done

  for steam in "${ProgramFiles:-}/Steam" "$pf86/Steam" "$HOME/.steam/steam" \
               "$HOME/Library/Application Support/Steam"; do
    [ -f "$steam/steamapps/libraryfolders.vdf" ] || continue
    while IFS= read -r lib; do
      add "$lib/steamapps/common/Kerbal Space Program" "Steam"
    done < <({ echo "$steam"; sed -n 's#.*"path"[[:space:]]*"\(.*\)".*#\1#p' "$steam/steamapps/libraryfolders.vdf" | sed 's#\\#/#g'; } | tr -d '\r')
  done

  # GOG and plain "Games" folders on any Windows drive
  for root in /c /d /e /f /g /h; do
    [ -d "$root" ] || continue
    for p in "$root"/GOG*/"Kerbal Space Program" "$root"/GOG*/*/"Kerbal Space Program" \
             "$root"/"Program Files"*/"GOG Galaxy"/Games/"Kerbal Space Program" \
             "$root"/Games/"Kerbal Space Program"; do
      add "$p" "GOG / other"
    done
  done
}

# Print the KSP install to use: $KSPDIR if set, else the only one found, else ask which one
find_kspdir() {
  if [ -n "${KSPDIR:-}" ]; then
    is_kspdir "$KSPDIR" || die "KSPDIR=$KSPDIR is not a KSP install (no GameData folder and game executable)"
    echo "$KSPDIR"
    return
  fi

  local paths=() labels=() path label i choice
  while IFS=$'\t' read -r path label; do
    paths+=("$path"); labels+=("$label")
  done < <(ksp_candidates)

  [ "${#paths[@]}" -gt 0 ] || die "no KSP install found; set KSPDIR to the folder that contains GameData"
  if [ "${#paths[@]}" -eq 1 ]; then
    echo "${paths[0]}"
    return
  fi

  # More than one: list them (stderr, because stdout is captured) and let the user pick
  {
    echo "KSP installs found:"
    for i in "${!paths[@]}"; do
      printf '  %d) %s  [%s]\n' "$((i + 1))" "${paths[$i]}" "${labels[$i]}"
    done
  } >&2
  if [ ! -t 0 ]; then
    die "several KSP installs found and there is no terminal to ask; set KSPDIR to one of them"
  fi
  while true; do
    read -r -p "Install into which one? [1-${#paths[@]}, Enter = 1]: " choice < /dev/tty >&2
    choice="${choice:-1}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#paths[@]}" ]; then
      echo "${paths[$((choice - 1))]}"
      return
    fi
    echo "Enter a number between 1 and ${#paths[@]}" >&2
  done
}

# Show the KSP installs that deploy/install can target
ksp_list() {
  local path label
  while IFS=$'\t' read -r path label; do
    printf '%s  [%s]\n' "$path" "$label"
  done < <(ksp_candidates)
}

ksp_running() {
  if command -v tasklist >/dev/null 2>&1; then tasklist 2>/dev/null | grep -qi "KSP_x64.exe"
  else pgrep -f "KSP.x86_64|KSP.app" >/dev/null 2>&1; fi
}

# Copy the built plugin into a KSP install (the one from find_kspdir)
install_plugin() {
  local dll="$PLUGIN_OUT/$CONFIG/KSPSerialIO.dll"
  [ -f "$dll" ] || die "plugin not built; run ./ci build_KSPSerialIO first (or use ./ci deploy)"

  local ksp dest
  ksp="$(find_kspdir)"
  ! ksp_running || die "KSP is running and keeps the plugin DLL locked; close it and try again"

  dest="$ksp/GameData/KSPSerialIO"
  log "Installing into $ksp"
  mkdir -p "$dest/PluginData/KSPSerialIO"
  cp "$dll" "$dest/"
  cp "$ROOT/KSPSerialIO/Includes/PsimaxSerial.dll" "$dest/"
  # Never overwrite a config the user has already edited, unless RESET_CONFIG=1 (the old one is kept as .bak)
  local cfg="$dest/PluginData/KSPSerialIO/config.xml"
  if [ ! -f "$cfg" ]; then
    cp "$ROOT/KSPSerialIO/config.xml" "$cfg"
    log "Copied the default config.xml (edit DefaultPort for your system)"
  elif [ "${RESET_CONFIG:-0}" = "1" ]; then
    cp "$cfg" "$cfg.bak"
    cp "$ROOT/KSPSerialIO/config.xml" "$cfg"
    log "Replaced config.xml with the default (the previous one is config.xml.bak)"
  elif ! cmp -s "$cfg" "$ROOT/KSPSerialIO/config.xml"; then
    log "Kept the existing config.xml, which differs from the default (RESET_CONFIG=1 replaces it)"
  else
    log "config.xml is up to date"
  fi
  log "Installed: $dest"
}

# Copy KSP.log (and Player.log) of the last run to build/perf/LABEL/. KSP overwrites its log on every launch,
# so do this after each measured run, before starting the game again. Works with KSP open or closed.
save_log() {
  local label="${1:-run}" ksp dest playerlog
  label="${label//[^A-Za-z0-9._-]/_}"
  ksp="$(find_kspdir)"
  [ -f "$ksp/KSP.log" ] || die "no KSP.log in $ksp"
  dest="$BUILD/perf/$label"
  mkdir -p "$dest"
  cp "$ksp/KSP.log" "$dest/KSP.log"
  for playerlog in "${LOCALAPPDATA:-}/../LocalLow/Squad/Kerbal Space Program/Player.log" \
                   "$HOME/.config/unity3d/Squad/Kerbal Space Program/Player.log"; do
    [ -f "$playerlog" ] && cp "$playerlog" "$dest/Player.log" && break
  done
  log "Saved $dest ($(grep -c 'KSPSerialIO: perf' "$dest/KSP.log") plugin perf lines, $(grep -c '\[KSPPerf\]' "$dest/KSP.log") KSPPerf lines)"
  echo "$dest/KSP.log"
}

# Take the plugin out of GameData without deleting it (KSP must be closed), to compare the game with and without it
disable_mod() {
  local ksp
  ksp="$(find_kspdir)"
  ! ksp_running || die "KSP is running; close it first"
  [ -d "$ksp/GameData/KSPSerialIO" ] || die "the plugin is not installed in $ksp"
  rm -rf "$ksp/KSPSerialIO.disabled"
  mv "$ksp/GameData/KSPSerialIO" "$ksp/KSPSerialIO.disabled"
  log "Plugin disabled (moved to $ksp/KSPSerialIO.disabled). Re-enable it with ./ci enable_mod"
}

# Put the plugin back into GameData after disable_mod
enable_mod() {
  local ksp
  ksp="$(find_kspdir)"
  ! ksp_running || die "KSP is running; close it first"
  [ -d "$ksp/KSPSerialIO.disabled" ] || die "no disabled plugin found in $ksp"
  [ ! -d "$ksp/GameData/KSPSerialIO" ] || die "$ksp/GameData/KSPSerialIO already exists"
  mv "$ksp/KSPSerialIO.disabled" "$ksp/GameData/KSPSerialIO"
  log "Plugin enabled again in $ksp/GameData/KSPSerialIO"
}

# Build the plugin and install it into the local KSP
deploy() {
  build_KSPSerialIO
  install_plugin
  log "Start KSP and look for 'KSPSerialIO:' lines in KSP.log / Player.log"
}

docs() {
  command -v doxygen >/dev/null 2>&1 || die "doxygen not found; install it from https://www.doxygen.nl/"
  log "Generating documentation"
  (cd "$ROOT" && doxygen Doxyfile)
  log "Output: $BUILD/docs/html/index.html"
}

PLANTUML_JAR="${PLANTUML_JAR:-$BUILD/tools/plantuml.jar}"
PLANTUML_URL="https://github.com/plantuml/plantuml/releases/latest/download/plantuml.jar"

ensure_plantuml() {
  command -v java >/dev/null 2>&1 || die "java not found; PlantUML needs a Java runtime"
  if [ ! -f "$PLANTUML_JAR" ]; then
    log "Downloading plantuml.jar"
    mkdir -p "$(dirname "$PLANTUML_JAR")"
    curl -fsSL -o "$PLANTUML_JAR" "$PLANTUML_URL"
  fi
  export PLANTUML_JAR
}

# Render every docs/diagrams/*.puml to SVG (also a quick way to validate diagram syntax)
diagrams() {
  ensure_plantuml
  log "Rendering diagrams"
  mkdir -p "$BUILD/diagrams"
  java -jar "$PLANTUML_JAR" -tsvg -o "$BUILD/diagrams" "$ROOT"/docs/diagrams/*.puml
  log "Output: $BUILD/diagrams"
}

# Skips the Windows Store "python" stub, which exists on PATH but is not a real interpreter
find_python() {
  local c
  # PATH first, then the default per-user and system install locations on Windows (a terminal
  # opened before Python was installed does not have the new PATH entry)
  for c in python3 python py \
      "${LOCALAPPDATA:-}"/Programs/Python/Python3*/python.exe \
      "${ProgramFiles:-}"/Python3*/python.exe; do
    if { command -v "$c" >/dev/null 2>&1 || [ -x "$c" ]; } && "$c" -c 'import sys; sys.exit(0)' >/dev/null 2>&1; then
      echo "$c"
      return
    fi
  done
  die "no working Python 3 found; install it from https://www.python.org/"
}

# Create build/venv on first use, install the given requirements file, print the venv bin directory
ensure_venv() {
  local py
  py="$(find_python)"
  if [ ! -d "$BUILD/venv" ]; then
    log "Creating virtual environment" >&2
    "$py" -m venv "$BUILD/venv" >&2
  fi
  local bin="$BUILD/venv/bin"
  [ -d "$BUILD/venv/Scripts" ] && bin="$BUILD/venv/Scripts"
  "$bin/python" -m pip install --quiet -r "$1" >&2
  echo "$bin"
}

sphinx() {
  ensure_plantuml
  local venv_bin
  venv_bin="$(ensure_venv "$ROOT/docs/requirements.txt")"

  log "Building Sphinx site"
  "$venv_bin/python" -m sphinx -b html "$ROOT/docs" "$BUILD/sphinx"

  # Embed the Doxygen API reference next to the Sphinx pages when Doxygen is available
  if command -v doxygen >/dev/null 2>&1; then
    docs
    rm -rf "$BUILD/sphinx/api"
    cp -r "$BUILD/docs/html" "$BUILD/sphinx/api"
  else
    log "doxygen not found: the API reference link will be missing"
  fi
  log "Output: $BUILD/sphinx/index.html"
}

# Print the port of the first connected board that matches FQBN (empty when there is none)
find_board_port() {
  local cli
  cli="$(find_arduino_cli)"
  "$cli" board list | awk -v fqbn="$FQBN" 'index($0, fqbn) { print $1; exit }'
}

# Upload the compiled sketch (build/sketch) to the board on PORT, or on the first board that matches FQBN
upload_sketch() {
  local cli port="${1:-${ARDUINO_PORT:-}}"
  cli="$(find_arduino_cli)"
  [ -n "$port" ] || port="$(find_board_port)"
  [ -n "$port" ] || die "no $FQBN board found; plug it in or pass the port (./ci upload_sketch COM5)"
  log "Uploading to $port"
  "$cli" upload -p "$port" --fqbn "$FQBN" --input-dir "${SKETCH_BUILD:-$BUILD/sketch}"
  echo "$port" > "$BUILD/last_upload_port"
}

# Run the protocol tests against the board. With no PORT, or if the board does not answer there,
# every USB COM port is tried.
run_board_test() {
  local venv_bin
  venv_bin="$(ensure_venv "$ROOT/tools/requirements.txt")"
  log "Testing the Arduino controller"
  "$venv_bin/python" "$ROOT/tools/test_arduino.py" $1
}

# Compile and upload the firmware (unless NO_UPLOAD=1), then test the board with the real protocol
test_arduino() {
  local port="${1:-${ARDUINO_PORT:-}}"
  if [ "${NO_UPLOAD:-0}" != "1" ]; then
    build_sketch
    upload_sketch "$port"
    port="$(cat "$BUILD/last_upload_port")"
    # The board reboots into the new sketch and may re-enumerate under another COM number
    log "Waiting for the board to restart"
    sleep 4
  fi
  run_board_test "$port"
}

# Build everything, install the plugin into a local KSP and flash the board. Everything that can
# fail (which KSP, KSP running, board missing) is checked first, so nothing is half done.
deploy_all() {
  local port="${1:-${ARDUINO_PORT:-}}"

  KSPDIR="$(find_kspdir)"
  export KSPDIR
  ! ksp_running || die "KSP is running and keeps the plugin DLL locked; close it and try again"
  [ -n "$port" ] || port="$(find_board_port)"
  [ -n "$port" ] || die "no $FQBN board found; plug it in or pass the port (./ci deploy_all COM5)"
  log "KSP: $KSPDIR"
  log "Board: $port ($FQBN)"

  build_KSPSerialIO
  build_sketch
  install_plugin
  upload_sketch "$port"

  if [ "${NO_TEST:-0}" != "1" ]; then
    port="$(cat "$BUILD/last_upload_port")"
    log "Waiting for the board to restart"
    sleep 4
    run_board_test "$port"
  fi
  log "Done: plugin installed in $KSPDIR, board flashed"
}

# ------------------------------------------------------------------ Raspberry Pi HMI (hmi-pi/)

HMI_DIR="$ROOT/hmi-pi"
HMI_HOST="${HMI_HOST:-ksphmi}"
HMI_APT_PACKAGES="python3-pygame libegl1 libegl-mesa0 libgles2 libgl1-mesa-dri"

hmi_ssh() { ssh -o BatchMode=yes -o ConnectTimeout=5 "$HMI_HOST" "$@"; }

# PC development venv (build/hmi-venv): pygame + krpc, kept apart from the tools venv
hmi_venv() {
  local py bin
  py="$(find_python)"
  [ -d "$BUILD/hmi-venv" ] || { log "Creating the HMI virtual environment" >&2; "$py" -m venv "$BUILD/hmi-venv" >&2; }
  bin="$BUILD/hmi-venv/bin"
  [ -d "$BUILD/hmi-venv/Scripts" ] && bin="$BUILD/hmi-venv/Scripts"
  "$bin/python" -m pip install --quiet --disable-pip-version-check -r "$HMI_DIR/requirements-dev.txt" >&2
  echo "$bin"
}

hmi() {
  local bin
  bin="$(hmi_venv)"
  cd "$HMI_DIR"
  "$bin/python" -m ksphmi --windowed "$@"
}

test_hmi() {
  log "HMI unit tests"
  (cd "$HMI_DIR" && PYTHONDONTWRITEBYTECODE=1 "$(ensure_venv "$ROOT/tools/requirements.txt")/python" -m unittest discover -s tests)
}

# Layout on the Pi: ~/ksphmi/app (replaced on every deploy), ~/ksphmi/venv (with the Debian pygame),
# ~/ksphmi/env (kRPC address), ~/ksphmi/config.local.toml (yours, never touched).
deploy_hmi() {
  hmi_ssh true || die "cannot reach '$HMI_HOST' over SSH; add a 'Host ksphmi' entry to ~/.ssh/config or set HMI_HOST (docs/hmi.rst)"
  test_hmi
  local missing pc_ip
  # SDL's kmsdrm driver needs Mesa EGL/GLES even for 2D drawing; Raspberry Pi OS Lite does not ship them
  missing="$(hmi_ssh "for p in $HMI_APT_PACKAGES; do dpkg -s \$p >/dev/null 2>&1 || echo \"  \$p not installed\"; done
    [ -e /var/lib/systemd/linger/\$USER ] || echo '  lingering off'")"
  [ -z "$missing" ] || die "the Pi needs its one-time setup:
$missing
run on the Pi: sudo apt install -y $HMI_APT_PACKAGES && sudo loginctl enable-linger \$USER"
  # The text console's blinking cursor is drawn over the HMI frames; only root can stop it (not fatal)
  # (the live cursor_blink value is not enough: it reads 0 whenever fbcon's timer happens to be stopped)
  if ! hmi_ssh 'test -f /etc/tmpfiles.d/ksphmi-cursor.conf'; then
    log "WARNING: the console cursor blinks over the HMI. Once, on the Pi:"
    log "  %s" "echo '\''w /sys/class/graphics/fbcon/cursor_blink - - - - 0'\'' | sudo tee /etc/tmpfiles.d/ksphmi-cursor.conf && sudo systemd-tmpfiles --create /etc/tmpfiles.d/ksphmi-cursor.conf"
  fi
  pc_ip="${HMI_KRPC_ADDRESS:-$(hmi_ssh 'echo "${SSH_CLIENT%% *}"')}"

  log "Copying hmi-pi to $HMI_HOST:~/ksphmi/app (kRPC server: $pc_ip)"
  # cd + relative names: GNU tar reads a "C:/..." argument as a remote host
  (cd "$HMI_DIR" && tar --exclude=__pycache__ -cf - ksphmi config.toml requirements.txt systemd) |
    hmi_ssh 'set -e; rm -rf ~/ksphmi/app.new; mkdir -p ~/ksphmi/app.new; tar -C ~/ksphmi/app.new -xf -; rm -rf ~/ksphmi/app; mv ~/ksphmi/app.new ~/ksphmi/app'

  log "Installing the Python packages and the service"
  hmi_ssh "set -e
    cd ~/ksphmi
    [ -x venv/bin/python ] || python3 -m venv --system-site-packages venv
    venv/bin/pip install --quiet --disable-pip-version-check -r app/requirements.txt
    printf 'KSPHMI_KRPC_ADDRESS=%s\n' '$pc_ip' > env
    mkdir -p ~/.config/systemd/user
    cp app/systemd/ksphmi.service ~/.config/systemd/user/
    systemctl --user daemon-reload
    systemctl --user enable ksphmi.service 2>/dev/null
    systemctl --user restart ksphmi.service"
  # Restart=always hides a crash loop behind "active": wait past RestartSec and require zero restarts
  sleep 8
  local state
  state="$(hmi_ssh 'echo "$(systemctl --user is-active ksphmi.service)/$(systemctl --user show ksphmi.service -p NRestarts --value)"' || true)"
  hmi_logs 15
  [ "$state" = "active/0" ] || die "the HMI service is not running cleanly on $HMI_HOST (state/restarts: $state, log above)"
  log "Done: HMI running on $HMI_HOST"
}

sim() {
  local bin
  bin="$(ensure_venv "$ROOT/tools/requirements.txt")"
  cd "$ROOT/tools"
  "$bin/python" -m kspsim "$@"
}

test_sim() {
  log "Simulator tests"
  (cd "$ROOT" && PYTHONDONTWRITEBYTECODE=1 "$(ensure_venv "$ROOT/tools/requirements.txt")/python" -m unittest tools/kspsim/test_kspsim.py)
}

# ------------------------------------------------------------------ C++ HMI (hmi-cpp/)
# On the Pi:  sudo apt install $HMI_CPP_APT_PACKAGES  (once), then ./ci build_hmi_cpp.
HMI_CPP_DIR="$ROOT/hmi-cpp"
HMI_CPP_APT_PACKAGES="build-essential cmake pkg-config libsdl2-dev libsdl2-ttf-dev fonts-freefont-ttf"
# Fallback for a Linux box without root (this PC's WSL): the same libraries unpacked into build/hmi-cpp-deps.
# Names are Ubuntu 24.04's (t64); SDL2's runtime needs the audio/X11 libraries even if it never opens them.
HMI_CPP_LOCAL_DEBS="libsdl2-dev libsdl2-2.0-0 libsdl2-ttf-dev libsdl2-ttf-2.0-0 fonts-freefont-ttf libxss1
  libasound2t64 libdecor-0-0 libpulse0 libsamplerate0 libsndfile1 libasyncns0 libflac12t64 libvorbisenc2
  libvorbis0a libogg0 libopus0 libmpg123-0t64 libmp3lame0"

# Windows has no C++ toolchain here: run the same ./ci target inside WSL when it is installed.
hmi_cpp_in_wsl() {
  local dir
  command -v wsl.exe >/dev/null || die "no C++ toolchain on Windows and no WSL: build on the Pi (sudo apt install $HMI_CPP_APT_PACKAGES)"
  dir="$(cygpath -m "$ROOT")"
  dir="/mnt/$(printf '%s' "${dir:0:1}" | tr 'A-Z' 'a-z')${dir:2}"
  log "No C++ toolchain on Windows: running ./ci $* in WSL"
  MSYS_NO_PATHCONV=1 wsl.exe -- bash -lc "cd '$dir' && ./ci $*"
}

hmi_cpp_env() {
  local deps="$BUILD/hmi-cpp-deps" lib arch dir
  command -v cmake >/dev/null && command -v g++ >/dev/null && command -v pkg-config >/dev/null ||
    die "C++ toolchain missing: sudo apt install $HMI_CPP_APT_PACKAGES"
  pkg-config --exists sdl2 SDL2_ttf 2>/dev/null && return 0
  command -v apt-get >/dev/null && command -v dpkg >/dev/null ||
    die "SDL2 development files missing: sudo apt install $HMI_CPP_APT_PACKAGES"
  if [ ! -f "$deps/.complete" ]; then
    log "SDL2 / SDL2_ttf not installed: unpacking the packages into $deps (no root needed)"
    rm -rf "$deps"; mkdir -p "$deps/debs"
    # shellcheck disable=SC2086
    (cd "$deps/debs" && apt-get download $HMI_CPP_LOCAL_DEBS) || die "apt-get download failed; or: sudo apt install $HMI_CPP_APT_PACKAGES"
    for f in "$deps"/debs/*.deb; do dpkg -x "$f" "$deps/root"; done
    touch "$deps/.complete"
  fi
  lib="$(ls -d "$deps"/root/usr/lib/*-linux-gnu | head -1)"
  arch="$(basename "$lib")"
  export PKG_CONFIG_PATH="$lib/pkgconfig" PKG_CONFIG_SYSROOT_DIR="$deps/root"
  # SDL2_ttf.pc names include dirs of -dev packages we do not need (harfbuzz, glib): CMake wants them to exist
  for dir in $(pkg-config --cflags-only-I sdl2 SDL2_ttf); do mkdir -p "${dir#-I}"; done
  export CXXFLAGS="${CXXFLAGS:-} -I$deps/root/usr/include/$arch"
  export LDFLAGS="${LDFLAGS:-} -Wl,-rpath-link,$lib:$lib/pulseaudio"
  export LD_LIBRARY_PATH="$lib:$lib/pulseaudio${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export KSPHMI_FONT="${KSPHMI_FONT:-$deps/root/usr/share/fonts/truetype/freefont/FreeSansBold.ttf}"
}

build_hmi_cpp() {
  if is_windows; then hmi_cpp_in_wsl build_hmi_cpp; return; fi
  hmi_cpp_env
  log "Building the C++ HMI into build/hmi-cpp"
  cmake -S "$HMI_CPP_DIR" -B "$BUILD/hmi-cpp" -DCMAKE_BUILD_TYPE=Release >/dev/null
  cmake --build "$BUILD/hmi-cpp" -j"$(nproc 2>/dev/null || echo 2)"
}

# End to end: tools/kspsim serves the real kRPC protocol; the C++ HMI must follow its vessel and draw a frame.
hmi_cpp_sim() {
  local py out port=50300 sim_pid rc=0
  py="${KSPSIM_PYTHON:-$(command -v python3)}" || die "python3 needed for tools/kspsim"
  "$py" -c "import krpc, google.protobuf" 2>/dev/null ||
    die "tools/kspsim needs the krpc and protobuf Python packages (pip install -r tools/requirements.txt)"
  out="$BUILD/hmi-cpp-sim"; mkdir -p "$out"
  log "kspsim on 127.0.0.1:$port/$((port + 1)), C++ HMI against it"
  (cd "$ROOT/tools" && exec "$py" -m kspsim --no-board --headless --seconds 40 --address 127.0.0.1 \
      --rpc-port "$port" --stream-port "$((port + 1))") >"$out/kspsim.log" 2>&1 &
  sim_pid=$!
  sleep 3
  KSPHMI_LOCAL_CONFIG=/dev/null "$BUILD/hmi-cpp/ksphmi" --address 127.0.0.1 --size 2520x1680 --seconds 8 \
      --screenshot "$out/flight.png" --config <(printf '[krpc]\nrpc_port = %d\nstream_port = %d\n' "$port" "$((port + 1))") \
      >"$out/hmi.log" 2>&1 || rc=$?
  kill "$sim_pid" 2>/dev/null || true
  wait "$sim_pid" 2>/dev/null || true
  cat "$out/hmi.log"
  [ "$rc" = 0 ] || die "C++ HMI exited with $rc"
  grep -q "following .* around Kerbin" "$out/hmi.log" || die "the C++ HMI never followed the simulated vessel"
  log "OK: followed the simulated vessel; frame saved to $out/flight.png"
}

test_hmi_cpp() {
  if is_windows; then hmi_cpp_in_wsl test_hmi_cpp "$@"; return; fi
  build_hmi_cpp
  log "C++ HMI unit and layout tests"
  (cd "$BUILD/hmi-cpp" && ctest --output-on-failure)
  if [ "${1:-}" = "--sim" ]; then hmi_cpp_sim; fi
}

hmi_logs() {
  # Raspberry Pi OS keeps no per-user journal: read the unit's lines from the system journal (user is in adm)
  hmi_ssh "journalctl _SYSTEMD_USER_UNIT=ksphmi.service -n ${1:-60} --no-pager -o short"
}

clean() {
  log "Removing build outputs"
  rm -rf "$BUILD" "$PLUGIN_OUT" "$ROOT/KSPSerialIO/KSPSerialIO/obj"
}

usage() { sed -n "2,44p" "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

case "${1:-help}" in
  build_sketch)      build_sketch ;;
  build_sketch_debug) build_sketch_debug ;;
  build_KSPSerialIO) build_KSPSerialIO ;;
  build_all)         build_KSPSerialIO; build_sketch ;;
  install)           install_plugin ;;
  deploy)            deploy ;;
  deploy_all)        shift; deploy_all "$@" ;;
  save_log)          shift; save_log "$@" ;;
  disable_mod)       disable_mod ;;
  enable_mod)        enable_mod ;;
  ksp_list)          ksp_list ;;
  docs)              docs ;;
  diagrams)          diagrams ;;
  sphinx)            sphinx ;;
  upload_sketch)     shift; upload_sketch "$@" ;;
  test_arduino)      shift; test_arduino "$@" ;;
  verify)            shift; "$(ensure_venv "$ROOT/tools/requirements.txt")/python" "$ROOT/tools/verify.py" "$@" ;;
  hmi)               shift; hmi "$@" ;;
  test_hmi)          test_hmi ;;
  deploy_hmi)        deploy_hmi ;;
  hmi_logs)          shift; hmi_logs "$@" ;;
  build_hmi_cpp)     build_hmi_cpp ;;
  test_hmi_cpp)      shift; test_hmi_cpp "$@" ;;
  sim)               shift; sim "$@" ;;
  test_sim)          test_sim ;;
  clean)             clean ;;
  help|-h|--help)    usage ;;
  *) usage >&2; exit 1 ;;
esac
