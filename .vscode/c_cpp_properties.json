{
    "version": 4,
    "configurations": [
        {
            "name": "UNO R4 WiFi",
            // Produced by ./ci build_sketch_debug (arduino-cli); has the exact include paths and defines.
            "compileCommands": "${workspaceFolder}/build/sketch-debug/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/arduino-sketch/KSPIODemo9",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/renesas_uno/1.6.0/cores/arduino",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/renesas_uno/1.6.0/variants/UNOWIFIR4",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/renesas_uno/1.6.0/libraries/**"
            ],
            "defines": ["ARDUINO=10607", "ARDUINO_UNOWIFIR4", "ARDUINO_UNOR4_WIFI", "ARDUINO_ARCH_RENESAS_UNO"],
            "compilerPath": "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/arm-none-eabi-gcc/7-2017q4/bin/arm-none-eabi-g++.exe",
            "cStandard": "c11",
            "cppStandard": "gnu++17",
            "forcedInclude": [],
            "intelliSenseMode": "gcc-arm"
        }
    ]
}
