# Doxygen configuration for KSPKontroller. Generate with: ./ci docs
PROJECT_NAME           = "KSPKontroller"
PROJECT_BRIEF          = "Physical Kerbal Space Program controller: KSP plugin and Arduino firmware"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = KSPSerialIO/KSPSerialIO/KSPIO.cs arduino-sketch/KSPIODemo9 README.md
FILE_PATTERNS          = *.cs *.ino *.md
USE_MDFILE_AS_MAINPAGE = README.md
# .ino sketches are C++ once the Arduino IDE concatenates them
EXTENSION_MAPPING      = ino=C++
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
SOURCE_BROWSER         = YES
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
