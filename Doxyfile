# Doxygen configuration for KSPKontroller. Generate with: ./ci docs
PROJECT_NAME           = "KSPKontroller"
PROJECT_BRIEF          = "KSP control panel and flight display: mod, Arduino firmware and C++ Raspberry Pi HMI"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = KSPSerialIO/KSPSerialIO/KSPIO.cs KSPSerialIO/KSPSerialIO/HmiContext.cs KSPSerialIO/KSPSerialIO.Hmi arduino-sketch/KSPIODemo9 hmi-cpp/include hmi-cpp/src README.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */bin/* */obj/*
FILE_PATTERNS          = *.cs *.ino *.hpp *.cpp *.md
USE_MDFILE_AS_MAINPAGE = README.md
IMAGE_PATH             = docs/images
# .ino sketches are C++ once the Arduino IDE concatenates them
EXTENSION_MAPPING      = ino=C++
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
SOURCE_BROWSER         = YES
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
