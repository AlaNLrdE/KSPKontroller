@startuml classes_firmware
title Firmware - structure of the sketch
!pragma layout smetana
hide empty members

class "KSPIODemo9.ino" as Main <<sketch file>> {
  +setup()
  +loop()
  pin and bit #defines
  Connected : boolean
  deadtime, controlTime : unsigned long
}

class "Input.ino" as Input <<sketch file>> {
  +input() : int
  +ControlStatus(bit) : byte
}

class "output.ino" as Output <<sketch file>> {
  +output()
  +controls()
  +controlsInit()
  +MainControls(bit, state)
  +ControlGroups(group, state)
}

class "SerialCOMS.ino" as Serial <<sketch file>> {
  +KSPBoardReceiveData() : boolean
  +KSPBoardSendData(address, length)
}

class "HandShake.ino" as HandShake <<sketch file>> {
  +Handshake()
}

class "utilities.ino" as Util <<sketch file>> {
  +Indicators()
  +initLEDS()
  +LEDSAllOff()
  +InitTxPackets()
}

class "matrix.ino" as Matrix <<sketch file>> {
  +matrixInit()
  +matrixUpdate()
}
class "debug.ino" as Debug <<sketch file>> {
  +debugReport()
}
struct DebugPacket <<packed, 52 bytes>>
struct DisplayCommand <<packed, 2 bytes>>
Main --> Matrix : init/update
Main --> Debug : loop calls
Debug ..> Serial : sends diagnostics
Debug ..> DebugPacket
Input ..> DisplayCommand : forced screen

struct VesselData <<packed, 214 bytes>>
struct ControlPacket <<packed, 25 bytes>>
struct HandShakePacket <<packed, 4 bytes>>

Main --> Input : loop() calls
Main --> Output : loop() calls
Main --> Util : setup() calls
Main *-- VesselData : VData
Main *-- ControlPacket : CPacket
Main *-- HandShakePacket : HPacket

Input ..> Serial : receives with
Input ..> HandShake : probe received
Input ..> Util : telemetry received
Input ..> VesselData : reads
Output ..> Serial : sends with
Output ..> ControlPacket : fills
HandShake ..> HandShakePacket : fills
HandShake ..> Serial : sends with
Util ..> VesselData : reads
Serial ..> VesselData : writes
Serial ..> HandShakePacket : writes
@enduml
