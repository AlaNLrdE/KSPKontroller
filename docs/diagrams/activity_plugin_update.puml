@startuml activity_plugin_update
title KSPSerialIO.Update (Unity main thread)
start
if (active vessel and LinkReady?) then (yes)
  if (new link or active vessel changed?) then (yes)
    :attach/move AxisInput hook idempotently\nreset control baseline where required;
  endif
  if (refresh interval elapsed?) then (yes)
    :sample orbit, speeds, resources, attitude, groups and stage into VData;
    :TrySendPacket(VData)\nreplace pending frame for SenderWorker;
  endif
  if (ControlReceived?) then (yes)
    :drain queued button events in receive order\ntoggle SAS/RCS for each transition\napply changed level switches;
    if (queued STAGE rising edge?) then (yes)
      if (request age in 0..1000 ms?) then (yes)
        :StageManager.ActivateNextStage();
      else (no)
        :log stale request;
      endif
      :consume each stage event;
    endif
    :apply changed custom groups, SAS mode and speed mode;
    :ControlReceived = false;
  endif
else (no)
  :skip serial telemetry and control application;
endif
:record enabled performance counters;
stop
@enduml
