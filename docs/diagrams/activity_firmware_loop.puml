@startuml activity_firmware_loop
title Firmware foreground scheduler
start
:setup: serial at 115200, reset cause, WDT,\nLEDs, packet IDs, inputs and matrix;
repeat
  :record loop interval and count\nWDT.refresh();
  partition "input()" {
    if (idle >2 s?) then (yes)
      :Connected = false, LEDs off\nreset partial receiver before parsing\nkeep unread serial bytes;
    endif
    if (complete valid packet?) then (yes)
      :update receive time\ndispatch handshake / telemetry / display command;
      :green LED on, Connected = true;
    else (no)
      if (ever connected and no valid packet >30 s?) then (yes)
        :NVIC_SystemReset();
      endif
    endif
  }
  partition "output()" {
    if (sample due and connected?) then (yes)
      :read enabled pins / debounce / update CPacket;
      if (relevant change or 200 ms keepalive due?) then (yes)
        :send one framed ControlPacket;
      endif
    endif
  }
  :debugReport() when due and connected;
  :matrixUpdate();
repeat while (foreground running)
@enduml
