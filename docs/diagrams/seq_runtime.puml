@startuml seq_runtime
title Steady-state exchange during flight

skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true

participant "KSP autopilot\n(physics step)" as AP
participant "KSPSerialIO\n(main thread)" as IO
participant "KSPSerialPort\n(main thread)" as SP
participant "Serial port" as Port
participant "SerialWorker\n(reader thread)" as Worker
participant "Arduino firmware\n(loop)" as FW

note over FW : loop() runs continuously
activate FW
note over Worker : thread alive since Awake
activate Worker

== Telemetry: KSP to controller (every refresh interval) ==
IO -> IO ++ : Update()
IO -> IO ++ : sample the active vessel into VData
return
IO -> SP ++ : sendPacket(VData)
SP -> Port ++ : Write([BE][EF][200][VData][checksum])
return
return
return

Port ->> FW : bytes over USB
FW -> FW ++ : input()
FW -> FW ++ : KSPBoardReceiveData()
return true, id = 1
FW -> FW ++ : Indicators()
return
note right of FW : Connected = true\ndeadtimeOld = now
return

== Controls: controller to KSP (every 25 ms while Connected) ==
FW -> FW ++ : output()
FW -> FW ++ : controls(): read switches and throttle
return
FW -> Port ++ : KSPBoardSendData(CPacket)
return
return

Port ->> Worker : bytes (EndRead returns)
Worker -> Worker ++ : ReceivedDataEvent(bytes)
Worker -> Worker ++ : parse frame and verify checksum
return valid packet
Worker -> Worker ++ : copy payload to NewPacketBuffer\nunder SerialMutex
return NewPacketFlag = true
return

... next frame on the main thread ...

SP -> SP ++ : Update()
SP -> SP ++ : InboundPacketHandler()
SP -> SP ++ : VesselControls()
return VControls decoded,\nControlReceived = true
return
return

IO -> IO ++ : Update()
IO -> IO ++ : apply the changed toggles, groups,\nSAS and navball modes to the vessel
return ControlReceived = false
return

== Axes (every physics step) ==
AP -> IO ++ : AxisInput(FlightCtrlState s)
IO -> IO ++ : merge pitch, roll, yaw, translation,\nwheels and throttle into s\n(per-axis mode from config.xml)
return
return s
@enduml
