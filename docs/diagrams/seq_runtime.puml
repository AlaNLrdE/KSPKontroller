@startuml seq_runtime
title Flight exchange: call activations and asynchronous transport
skinparam sequenceMessageAlign left
participant "KSPSerialIO\nUnity main thread" as IO
participant "KSPSerialPort\nqueue / dispatch methods" as SP
participant "SenderWorker" as TX
participant "Serial transport" as Port
participant "SerialWorker" as RX
participant "Arduino loop" as FW
== Telemetry at configured refresh ==
activate IO
IO -> IO : sample active vessel into VData
IO -> SP : TrySendPacket(VData)
activate SP
SP -> SP : build frame; replace pending under sendLock
SP --> IO : queued (no serial write wait)
deactivate SP
deactivate IO
activate TX
TX -> SP : take newest pending frame under sendLock
activate SP
SP --> TX : frame
deactivate SP
TX -> Port : Write(BE EF 214 payload checksum)
activate Port
Port --> TX : write completed or failed
deactivate Port
deactivate TX
Port ->> FW : received serial bytes
activate FW
FW -> FW : input(): assemble / validate / copy VData
FW -> FW : Indicators(); Connected=true
deactivate FW
== Sample every 25 ms; transmit on change or 200 ms keepalive ==
activate FW
FW -> FW : output(): read enabled pins / debounce
FW -> Port : KSPBoardSendData(ControlPacket)
activate Port
Port --> FW : frame written
deactivate Port
deactivate FW
Port ->> RX : read completion with bytes
activate RX
RX -> RX : parse frame and validate
RX -> SP : capture button edges + receive time\nstore latest packet under SerialMutex
activate SP
SP --> RX : packet available
deactivate SP
deactivate RX
== Main-thread dispatch and control application ==
activate SP
SP -> SP : Update() / InboundPacketHandler()\ndecode latest controls
deactivate SP
activate IO
IO -> SP : consume latest controls and queued button events
activate SP
SP --> IO : VControls / ordered button events
deactivate SP
IO -> IO : apply level changes / SAS-RCS transitions\nconsume fresh stage request
deactivate IO
== Physics callback ==
activate IO
IO -> IO : AxisInput(FlightCtrlState)\nmerge configured analog axes
deactivate IO
note over TX, RX : Worker lifelines continue between illustrated calls.\nSerial arrival is asynchronous; Unity callbacks run on the main thread.
@enduml
