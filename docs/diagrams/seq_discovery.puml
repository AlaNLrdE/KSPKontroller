@startuml seq_discovery
title Discovery: startup call stack and later supervisor work
skinparam sequenceMessageAlign left
participant "KSPSerialPort.Awake\nUnity main thread" as Awake
participant "TryConnect\ncalled by startup or supervisor" as Connect
participant "Serial transport / reader" as Port
participant "Arduino loop" as FW
participant "SupervisorWorker" as Supervisor
activate Awake
Awake -> Awake : stop obsolete supervisor; reset link flags
alt compatible controller remembered
  Awake -> Port : recreate port/reader (Begin)
  activate Port
  Port --> Awake : initialized; Start opens if needed
  deactivate Port
else initial discovery required
  Awake -> Connect : TryConnect(BuildCandidates(), delay, reply wait)
  activate Connect
  loop eligible present ports, last/default first
    Connect -> Port : open, assert DTR, settle
    activate Port
    Port --> Connect : opened or error
    deactivate Port
    opt port opened
      Connect -> Port : send framed id=0 probe 1,2,3
      activate Port
      Port --> Connect : written
      deactivate Port
      Port ->> FW : serial probe bytes
      activate FW
      FW -> FW : input() / Handshake()
      FW -->> Port : framed id=0 reply 3,1,4
      deactivate FW
      activate Port
      Port --> Connect : validated reply or timeout
      deactivate Port
    end
    alt valid reply
      Connect -> Connect : mark link up; stop scanning
    else no valid reply
      Connect -> Port : close failed candidate
      activate Port
      Port --> Connect : closed
      deactivate Port
    end
  end
  Connect --> Awake : connected or no controller
  deactivate Connect
end
Awake ->> Supervisor : start supervisor thread
deactivate Awake
activate Supervisor
loop while flight component lives
  Supervisor -> Supervisor : monitor failures/silence
  opt link down
    Supervisor -> Connect : rebuild candidates and TryConnect()
    activate Connect
    ref over Connect, FW : Same framed probe/reply exchange as above
    Connect --> Supervisor : connected or no reply
    deactivate Connect
    opt not connected
      Supervisor -> Supervisor : wait 2000 ms or stop signal
    end
  end
end
deactivate Supervisor
note over Awake : Initial discovery can block scene loading.\nLater retries execute on the supervisor, not Unity's frame loop.
@enduml
