@startuml seq_discovery
title Controller discovery when the flight scene loads

skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true

participant "KSPSerialPort.Awake\n(main thread)" as Awake
participant "Serial port" as Port
participant "SerialWorker\n(reader thread)" as Worker
participant "Arduino firmware\n(loop)" as FW
participant "KSPSerialIO.Start\n(main thread)" as Start

note over FW : loop() runs continuously
activate FW

== KSPSerialPort.Awake: controller not found yet ==
activate Awake
Awake -> Awake ++ : initializeDataPackets()
return HPacket = 1, 2, 3

Awake -> Awake ++ : Begin()
Awake ->> Worker : Thread.Start(SerialWorker)
activate Worker
note right of Worker
  Lives until PortCleanup().
  Sleeps 500 ms while the port is closed.
end note
deactivate Awake

loop for each candidate port (DefaultPort first, then the registry list)
  Awake -> Port ++ : Open()
  return opened, or an exception

  alt opened and HandshakeDisable = 0
    Awake -> Awake ++ : Thread.Sleep(HandshakeDelay)
    return

    Awake -> Awake ++ : sendPacket(HandShakePacket 1, 2, 3)
    Awake -> Port ++ : Write(frame)
    return
    return

    Port ->> FW : bytes over USB
    FW -> FW ++ : input()
    FW -> FW ++ : KSPBoardReceiveData()
    return true, id = 0
    FW -> FW ++ : Handshake()
    FW -> Port ++ : KSPBoardSendData(HPacket 3, 1, 4)
    return
    return
    return

    Port ->> Worker : bytes (EndRead returns)
    Worker -> Worker ++ : ReceivedDataEvent(bytes)
    Worker -> Worker ++ : InboundPacketHandler()
    note right of Worker : Runs on this thread because\nDisplayFound is still false
    Worker -> Worker ++ : HandShake()
    return
    note right of Worker : M1, M2, M3 = 3, 1, 4\nDisplayFound = true
    return
    return

    Awake -> Awake ++ : wait for DisplayFound\n(up to 15 x 100 ms)
    return DisplayFound

    Awake -> Port ++ : Close()
    return

    opt DisplayFound
      note over Awake : stop scanning ports
    end
  else opened and HandshakeDisable = 1
    note over Awake : DisplayFound = true\nport stays open
  else open failed
    note over Awake : log the error,\ntry the next port
  end
end
deactivate Awake

== KSPSerialIO.Start ==
activate Start
Start -> Port ++ : Open() if it is closed
return
Start -> Start ++ : Thread.Sleep(HandshakeDelay + 200 ms)
return
Start -> Start ++ : hook AxisInput on the active vessel
return
Start -> Start ++ : sync RCS, SAS, lights, gear, brakes,\nabort, stage and groups from VControls
return
deactivate Start
@enduml
