# systemd *user* unit of the HMI (hmi-cpp/), installed by ./ci deploy_hmi into ~/.config/systemd/user/.
# ./ci deploy_hmi copies hmi-cpp/ to ~/ksphmi/cpp and builds it there (~/ksphmi/cpp/build/ksphmi).
# Settings: ~/ksphmi/cpp/config.toml (defaults, replaced on every deploy), then ~/ksphmi/config.local.toml (yours,
# never touched), then ~/ksphmi/env (KSPHMI_KRPC_ADDRESS, written by ./ci deploy_hmi).
# Runs without a desktop: frames are copied to the Linux framebuffer /dev/fb0 (user in group video). Needs lingering
# (sudo loginctl enable-linger $USER) so it starts at boot without anybody logged in.
[Unit]
Description=KSP HMI flight data display

[Service]
# fbdev = SDL software renderer + /dev/fb0, the proven path on the Pi 4.
# To try the GPU instead: KSPHMI_OUTPUT=sdl and SDL_VIDEODRIVER=kmsdrm (needs Mesa EGL/GLES and DRM master).
Environment=KSPHMI_OUTPUT=fbdev
Environment=KSPHMI_APP_DIR=%h/ksphmi/cpp
Environment=KSPHMI_LOCAL_CONFIG=%h/ksphmi/config.local.toml
EnvironmentFile=-%h/ksphmi/env
WorkingDirectory=%h/ksphmi/cpp
ExecStart=%h/ksphmi/cpp/build/ksphmi
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
