#!/bin/sh
# NetworkManager dispatcher: Ethernet first, Wi-Fi (connection "wifi-fallback") only without the cable.
# eth0 up -> Wi-Fi down (one address per host name, so kspKontrollerPi.local does not flip between two IPs);
# eth0 down -> Wi-Fi up. At boot without the cable NetworkManager autoconnects the Wi-Fi by itself.
[ "$1" = eth0 ] || exit 0
case "$2" in
    up)   nmcli connection down wifi-fallback >/dev/null 2>&1 ;;
    down) nmcli connection up wifi-fallback >/dev/null 2>&1 & ;;
esac
exit 0
